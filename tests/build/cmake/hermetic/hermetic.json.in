  },
  "modules": [
    {
      "name": "hermetic",
      "sources": [{ "path": "CMakeLists.txt" }],
      "build": ["cmake -S . -B out -DCMAKE_INSTALL_PREFIX=\"$PREFIX\""]
    }
  ]
}
