{
  "id": "test.build.hello",
  "version": "1",
  "command": "bin/hello.exe",
  "sdk": {
    "zig": "org.ziglang.zig@@ZIG@",
    "busybox": "net.frippery.busybox@@BUSYBOX@"
  },
  "cleanup": ["/include", "/lib"],
  "modules": [
    {
      "name": "greet",
      "sources": [{ "path": "greet.c" }, { "path": "greet.h" }],
      "build": [
        "zig cc -target x86_64-windows-gnu -O2 -c greet.c -o greet.o",
        "zig ar rcs libgreet.a greet.o",
        "mkdir -p \"$PREFIX/include\" \"$PREFIX/lib\"",
        "cp greet.h \"$PREFIX/include\" && cp libgreet.a \"$PREFIX/lib\""
      ]
    },
    {
      "name": "app",
      "sources": [{ "path": "main.c" }],
      "build": [
        "mkdir -p \"$PREFIX/bin\"",
        "zig cc -target x86_64-windows-gnu -O2 -s -I\"$PREFIX/include\" -o \"$PREFIX/bin/hello.exe\" \"$PWD/main.c\" \"$PREFIX/lib/libgreet.a\""
      ]
    },
    {
      "name": "notes",
      "shell": "cmd",
      "build": ["echo built by cmd> %PREFIX%\\notes.txt"]
    }
  ]
}
