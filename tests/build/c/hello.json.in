{
  "id": "test.build.hello",
  "version": "1",
  "command": "bin/hello.exe",
  "sdk": {
    "zig": "org.ziglang.zig@@ZIG@",
    "busybox": "net.frippery.busybox@@BUSYBOX@"
  },
  "cleanup": ["/include", "/lib"],
  "modules": [
    {
      "name": "greet",
      "sources": [{ "path": "greet.c" }, { "path": "greet.h" }, { "path": "twice.cpp" }],
      "build": [
        "cc -O2 -c greet.c -o greet.o",
        "c++ -O2 -fno-exceptions -fno-rtti -c twice.cpp -o twice.o",
        "ar rc libgreet.a greet.o twice.o && ranlib libgreet.a",
        "mkdir -p \"$PREFIX/include\" \"$PREFIX/lib\"",
        "cp greet.h \"$PREFIX/include\" && cp libgreet.a \"$PREFIX/lib\""
      ]
    },
    {
      "name": "app",
      "sources": [{ "path": "main.c" }, { "path": "hello.rc" }],
      "build": [
        "mkdir -p \"$PREFIX/bin\"",
        "rc /fo hello.res hello.rc",
        "cc -O2 -s -I\"$PREFIX/include\" -o \"$PREFIX/bin/hello.exe\" \"$PWD/main.c\" hello.res \"$PREFIX/lib/libgreet.a\""
      ]
    },
    {
      "name": "notes",
      "shell": "cmd",
      "build": ["echo built by cmd> %PREFIX%\\notes.txt"]
    }
  ]
}
