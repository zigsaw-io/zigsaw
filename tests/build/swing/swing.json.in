{
  "id": "test.build.swing",
  "version": "1",
  "command": "${java}\\bin\\java.exe",
  "args": ["-jar", "${app}\\swing.jar"],
  "exports": {},
  "runtimes": { "java": "org.openjdk.java@@JAVA@" },
  "sdk": {
    "jdk": "org.openjdk.java.Sdk@@JAVASDK@",
    "busybox": "net.frippery.busybox@@BUSYBOX@"
  },
  "modules": [
    {
      "name": "swing",
      "sources": [{ "path": "Swing.java" }],
      "build": [
        "javac -d classes Swing.java",
        "jar --create --file \"$PREFIX/swing.jar\" --main-class Swing --date 2026-01-01T00:00:02Z -C classes ."
      ]
    }
  ]
}
