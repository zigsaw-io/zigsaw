{
  "id": "test.gtk.hello",
  "version": "1",
  "command": "bin/hello-gtk.exe",
  "path": ["bin"],
  "permissions": { "network": true, "filesystem": ["cwd"] },
  "runtimes": { "gtk": "org.gtk.Gtk4@@GTK@" },
  "sdk": { "gtksdk": "org.gtk.Gtk4.Sdk@@GTKSDK@" },
  "modules": [
    {
      "name": "hello",
      "sources": [{ "path": "meson.build" }, { "path": "hello.c" }, { "path": "soup.c" }, { "path": "svg.c" }, { "path": "spell.c" }, { "path": "font.c" }],
      "build": ["meson setup out --prefix=\"$PREFIX\"", "meson install -C out"]
    }
  ]
}
