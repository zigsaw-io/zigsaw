{
  "id": "io.github.zigsaw-io.zigsaw",
  "version": "0.59.0",
  "name": "zigsaw",
  "summary": "zigsaw, built by zigsaw from this checkout, as its releases are built",
  "homepage": "https://github.com/zigsaw-io/zigsaw",
  "license": "BSD-3-Clause",
  "command": "bin\\zigsaw.exe",
  "exports": {},
  "sdk": {
    "zig": "org.ziglang.zig:0.17.0@sha256:93ec2b6b36708ae80ffac87872e70dafaee350cd2d49a95dd2fa5847d0a10449"
  },
  "modules": [
    {
      "name": "zigsaw",
      "sources": [
        { "path": ".", "skip": ["/.github", "/docs", "/recipes", "/scripts", "/tests", "/README.md"] }
      ],
      "shell": "cmd",
      "build": ["zig build -Dstrip -p %PREFIX%"]
    }
  ]
}
