# Keep LF line endings on checkout, whatever core.autocrlf says: bash can't
# run scripts with CRLF, and zig fmt writes (and checks for) LF.
*.sh  text eol=lf
*.zig text eol=lf
*.zon text eol=lf
*.json text eol=lf
*.md  text eol=lf

# Test fixtures are compared byte for byte.
src/testdata/** binary
tests/osm2pgsql/*.pbf binary

# Batch files need CRLF line endings: cmd.exe misreads labels without them.
tests/batch/*.cmd text eol=crlf
tests/install/*.cmd text eol=crlf

# Hashed for releases (SHA256SUMS), so the same bytes on every checkout.
*.ps1 text eol=lf

# Every file a recipe carries (patches, headers, scripts, a ._pth): an image
# records each one's hash, so it must have the same bytes on every checkout,
# a runner's (core.autocrlf=true) too. Rnote's and Text Editor's lacked this
# until iteration 36, so CI's builds of them had other configs. text=auto
# leaves a binary file alone.
recipes/** text=auto eol=lf
