// The version information of zigsaw.exe and the shims, which Explorer shows
// in a file's properties. build.zig defines what differs between them:
//
//   ZIGSAW_VERSION          "0.22.0", build.zig.zon's version
//   ZIGSAW_VERSION_NUMBERS  0,22,0,0
//   ZIGSAW_DESCRIPTION      what the program is
//   ZIGSAW_FILE_NAME        "zigsaw.exe", the name it's built as
//
// Numbers stand for winver.h's names (VOS_NT_WINDOWS32, VFT_APP), so that
// it's compiled without any headers: zig rc would otherwise take them from
// whatever Visual Studio the machine has.

1 VERSIONINFO
FILEVERSION ZIGSAW_VERSION_NUMBERS
PRODUCTVERSION ZIGSAW_VERSION_NUMBERS
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bradley Tran"
            VALUE "FileDescription", ZIGSAW_DESCRIPTION
            VALUE "FileVersion", ZIGSAW_VERSION
            VALUE "InternalName", ZIGSAW_FILE_NAME
            VALUE "LegalCopyright", "Copyright (c) 2026, Bradley Tran. BSD 3-Clause License."
            VALUE "OriginalFilename", ZIGSAW_FILE_NAME
            VALUE "ProductName", "zigsaw"
            VALUE "ProductVersion", ZIGSAW_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
