{
  "id": "org.nodejs.node",
  "version": "24.22.2",
  "name": "Node.js",
  "summary": "The JavaScript runtime, with npm",
  "homepage": "https://nodejs.org/",
  "license": "MIT",
  "command": "node.exe",
  "path": [".", "${data}\\npm"],
  "env": {
    "NPM_CONFIG_PREFIX": "${data}\\npm",
    "NODE_OPTIONS": "--preserve-symlinks --preserve-symlinks-main",
    "NODE_USE_SYSTEM_CA": "1"
  },
  "permissions": { "sandbox": "soft", "network": true, "filesystem": ["cwd"] },
  "exports": {
    "node": { "command": "node.exe" },
    "npm": { "command": "node.exe", "args": ["${app}\\node_modules\\npm\\bin\\npm-cli.js"] },
    "npx": { "command": "node.exe", "args": ["${app}\\node_modules\\npm\\bin\\npx-cli.js"] }
  },
  "modules": [
    {
      "name": "node",
      "sources": [
        {
          "url": "https://nodejs.org/dist/v24.22.2/node-v24.22.2-win-x64.zip",
          "sha256": "ca1bff5d8ead13c9f2ea404a176db46bd430704d5b5113734049fa365e7799e2",
          "strip": 1
        }
      ]
    }
  ]
}
