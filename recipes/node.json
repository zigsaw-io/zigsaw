{
  "id": "org.nodejs.node",
  "version": "24.21.0",
  "command": "node.exe",
  "path": [".", "${data}\\npm"],
  "env": {
    "NPM_CONFIG_PREFIX": "${data}\\npm",
    "NODE_OPTIONS": "--preserve-symlinks --preserve-symlinks-main"
  },
  "permissions": { "network": true, "filesystem": ["cwd"] },
  "exports": {
    "node": { "command": "node.exe" },
    "npm": { "command": "node.exe", "args": ["${app}\\node_modules\\npm\\bin\\npm-cli.js"] },
    "npx": { "command": "node.exe", "args": ["${app}\\node_modules\\npm\\bin\\npx-cli.js"] }
  },
  "modules": [
    {
      "name": "node",
      "sources": [
        {
          "url": "https://nodejs.org/dist/v24.21.0/node-v24.21.0-win-x64.zip",
          "sha256": "158f7685b44de51f6c0df1d153526cbcd3e1bc739a8dfc607721cef75de9e541",
          "strip": 1
        }
      ]
    }
  ]
}
