        "sed -i -e \"s/^    nm = find_program('nm')$/    nm = find_program('nm', required: false, disabler: true)/\" -e '/^    link_depends: librsvg_ver,$/d' rsvg/meson.build",
        "grep -q \"find_program('nm', required: false, disabler: true)\" rsvg/meson.build && ! grep -q 'link_depends: librsvg_ver' rsvg/meson.build",
