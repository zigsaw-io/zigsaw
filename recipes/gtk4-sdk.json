        "! grep -q merge_file demo/data/meson.build",
        "sed -i \"s/^demo_kwargs = {}$/demo_kwargs = { 'win_subsystem': 'windows' }/\" demo/meson.build",
        "grep -q \"^demo_kwargs = { 'win_subsystem': 'windows' }$\" demo/meson.build",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dintrospection=disabled -Dvapi=false -Ddocumentation=false -Dtests=false -Dexamples=true",
