{
  "id": "org.gtk.Gtk4.Sdk",
  "version": "4.24.1",
  "name": "GTK SDK",
  "summary": "GTK 4, libadwaita and the stack below them, with headers, import libraries, introspection data and the tools to build GTK apps with zig",
  "homepage": "https://www.gtk.org/",
  "license": "LGPL-2.1-or-later",
  "command": "bin/gtk4-demo.exe",
  "path": ["bin"],
  "env": {
    "PKG_CONFIG_PATH": "${app}\\lib\\pkgconfig;${app}\\share\\pkgconfig",
    "RC": "rc /:auto-includes gnu"
  },
  "permissions": { "filesystem": ["cwd"] },
  "exports": {
    "cc": { "command": "${zig}/zig.exe", "args": ["cc", "-target", "x86_64-windows-gnu"] },
    "c++": { "command": "${zig}/zig.exe", "args": ["c++", "-target", "x86_64-windows-gnu"] },
    "ar": { "command": "${zig}/zig.exe", "args": ["ar"] },
    "rc": { "command": "${zig}/zig.exe", "args": ["rc", "/:auto-includes", "gnu"] },
    "pkg-config": { "command": "${meson}/bin/pkgconf.exe" },
    "meson": { "command": "${meson}/python.exe", "args": ["${meson}\\meson\\meson.py"] },
    "ninja": { "command": "${meson}/ninja.exe" },
    "sh": { "command": "${busybox}/busybox.exe", "args": ["sh"] },
    "make": { "command": "${busybox}/busybox.exe", "args": ["make"] },
    "glib-compile-resources": { "command": "bin/glib-compile-resources.exe" },
    "glib-compile-schemas": { "command": "bin/glib-compile-schemas.exe" },
    "gtk4-builder-tool": { "command": "bin/gtk4-builder-tool.exe" },
    "msgfmt": { "command": "bin/msgfmt.exe" },
    "msgmerge": { "command": "bin/msgmerge.exe" },
    "xgettext": { "command": "bin/xgettext.exe" },
    "windres": { "command": "bin/windres.exe" },
    "nm": { "command": "bin/nm.exe" },
    "g-ir-scanner": { "command": "bin/g-ir-scanner.exe" },
    "g-ir-compiler": { "command": "bin/g-ir-compiler.exe" }
  },
  "cleanup": ["__pycache__"],
  "sdk": {
    "cmake": "org.cmake.cmake:4.4.4@sha256:fdc6a6bb933b2d7994fba0ccdb07a2a91a02012a6e4879cf67ad451e53e6f53d",
    "perl": "org.perl.perl:5.42.3.1@sha256:4459f0a9487860f976ef170b4e55c10e4889b2eff314c9eaacf4c42135406773",
    "rust": "org.rust-lang.rust:1.99.0@sha256:e7e9706485bba88759915d9509993d0e41d340d7d8dfec6426fce1feda9a10e2",
    "cargo-c": "com.github.lu-zero.cargo-c:0.10.25@sha256:5c3ab8267b4c4a8f4a1628ef7f0d8f62f9838a28f46df2800a13f542e71bed71"
  },
  "runtimes": {
    "meson": "com.mesonbuild.meson:1.12.1@sha256:9f1660936c3c00e44f1b90a83c72f20a28023b8f5f85bb61505f33c00ef4f767",
    "zig": "org.ziglang.zig:0.16.0@sha256:0379659d0e7a87ac7912ea6bd12fc929f889b554706e91299c8063235afea355",
    "busybox": "net.frippery.busybox:FRP-6075-g169694ebd@sha256:db9d39727bfdd4d176b5878c0a125daa8a2396ea21e0f01a6a372f53d9d97e5d"
  },
  "modules": [
    {
      "name": "crt-noexport",
      "build": [
        "printf '%s\\n' '.section .drectve' '.ascii \" -exclude-symbols:atexit,_CRT_INIT,__mingw_module_is_dll\"' > noexport.s",
        "cc -c noexport.s -o noexport.o"
      ]
    },
    {
      "name": "base",
      "sources": [{ "image": "org.gtk.Gtk4.Sdk.Base:4.24.1@sha256:542571a6fe381fb398a61b6135c3385411b5414a02e7bc87c6e3bd57fa899e97" }]
    },
    {
      "name": "hicolor-icon-theme",
      "sources": [
        {
          "url": "https://icon-theme.freedesktop.org/releases/hicolor-icon-theme-0.18.tar.xz",
          "sha256": "db0e50a80aa3bf64bb45cbca5cf9f75efd9348cf2ac690b907435238c3cf81d7",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\"",
        "meson install -C out"
      ]
    },
    {
      "name": "adwaita-icon-theme",
      "sources": [
        {
          "url": "https://download.gnome.org/sources/adwaita-icon-theme/51/adwaita-icon-theme-51.0.tar.xz",
          "sha256": "ba561cf3c96305a47179fa5605856ad695c9238ea07f7093aebd9ba80c4e323b",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\"",
        "meson install -C out"
      ]
    },
    {
      "name": "libadwaita",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu", "CFLAGS": "-s" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/libadwaita/1.10/libadwaita-1.10.0.tar.xz",
          "sha256": "b1bf56239269d101a6391ad4553c910eff9cc6170b803916405477ef60a66c84",
          "strip": 1
        }
      ],
      "build": [
        "sed -i -e 's/i18n[.]merge_file(/configure_file(copy: true,/' -e '/^ *po_dir:/d' -e '/^ *type:/d' demo/data/meson.build",
        "! grep -q merge_file demo/data/meson.build",
        "sed -i \"s/^demo_kwargs = {}$/demo_kwargs = { 'win_subsystem': 'windows' }/\" demo/meson.build",
        "grep -q \"^demo_kwargs = { 'win_subsystem': 'windows' }$\" demo/meson.build",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dintrospection=enabled -Dvapi=false -Ddocumentation=false -Dtests=false -Dexamples=true",
        "meson install -C out"
      ]
    },
    {
      "name": "openssl",
      "env": { "CFLAGS": "-s -O2", "PERL": "perl", "PERL5OPT": "-IB:/src/openssl/zigsaw -Munixspec" },
      "sources": [
        {
          "url": "https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz",
          "sha256": "603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a",
          "strip": 1
        },
        { "path": "gtk4-sdk/openssl-unixspec.pm", "dest": "zigsaw/unixspec.pm" }
      ],
      "build": [
        "perl Configure mingw64 no-shared no-asm no-tests no-docs no-apps no-module --prefix=\"$PREFIX\" --libdir=lib",
        "make build_generated $(sed -n '/^GENERATED=/,/[^\\\\]$/p' Makefile | tr ' ' '\\n' | grep '[.][ch]$')",
        "make -n build_libs | grep -e ' -c -o ' | tr '\\n' '\\0' | xargs -0 -P \"$(nproc)\" -n 1 sh -c",
        "make build_sw",
        "make install_dev"
      ]
    },
    {
      "name": "sqlite",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://sqlite.org/2026/sqlite-amalgamation-3530400.zip",
          "sha256": "1e71ddf93849c6a6ecf58b827c0692073d2dd7ee40196158068f7b29f422e87d",
          "strip": 1
        },
        {
          "url": "https://wrapdb.mesonbuild.com/v2/sqlite3_3.53.4-1/get_patch",
          "sha256": "fe8033e209d350fa74e52ce1398253b373e7cfdd6809bc9f304e409e76f108af",
          "type": "zip",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release",
        "meson install -C out"
      ]
    },
    {
      "name": "nghttp2",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o" },
      "sources": [
        {
          "url": "https://github.com/nghttp2/nghttp2/releases/download/v1.70.0/nghttp2-1.70.0.tar.xz",
          "sha256": "e05cb1388eaca3830aded4ccf20044b6e1ac1a61411dcca11b0437c4285c8bc2",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DENABLE_LIB_ONLY=ON -DBUILD_SHARED_LIBS=ON -DBUILD_STATIC_LIBS=OFF -DENABLE_DOC=OFF -DBUILD_TESTING=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "libpsl",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://github.com/rockdaboot/libpsl/releases/download/0.23.3/libpsl-0.23.3.tar.gz",
          "sha256": "93941f85a1e7bd593fa94f299233cb5dfc91cd144fd9a78a6ceb75001c5b03be",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Druntime=no -Dbuiltin=true -Dtests=false -Ddocs=false",
        "meson install -C out"
      ]
    },
    {
      "name": "glib-networking",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/glib-networking/2.90/glib-networking-2.90.0.tar.xz",
          "sha256": "83a75e3d9c36b66ee86d3281c2fc997816101968a5126ba322b2acb9a74dd8c0",
          "strip": 1
        }
      ],
      "build": [
        "sed -i 's/CertOpenSystemStoreW (0, source_cert_store_name)/CertOpenStore (CERT_STORE_PROV_SYSTEM_W, 0, 0, CERT_SYSTEM_STORE_CURRENT_USER | CERT_STORE_READONLY_FLAG, source_cert_store_name)/' tls/openssl/gtlsdatabase-openssl.c",
        "grep -q CERT_STORE_READONLY_FLAG tls/openssl/gtlsdatabase-openssl.c",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dgnutls=disabled -Dopenssl=enabled -Dlibproxy=disabled -Dgnome_proxy=disabled -Denvironment_proxy=enabled -Dtests=false",
        "meson install -C out"
      ]
    },
    {
      "name": "libsoup",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/libsoup/3.8/libsoup-3.8.0.tar.xz",
          "sha256": "bbf08fa3e03a88c31a3d27a0d87cb422e9490f2d08e149211103df6d638a2238",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dtls_check=false -Dgssapi=disabled -Dntlm=disabled -Dbrotli=disabled -Dzstd=disabled -Dintrospection=enabled -Dvapi=disabled -Ddocs=disabled -Ddoc_tests=false -Dtests=false -Dautobahn=disabled -Dsysprof=disabled -Dpkcs11_tests=disabled",
        "meson install -C out"
      ]
    },
    {
      "name": "freetype",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://downloads.sourceforge.net/project/freetype/freetype2/2.14.3/freetype-2.14.3.tar.xz",
          "sha256": "36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dbrotli=disabled -Dbzip2=disabled -Dharfbuzz=disabled -Dpng=disabled -Dzlib=disabled -Dtests=disabled",
        "meson install -C out"
      ]
    },
    {
      "name": "libxml2",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.4.tar.xz",
          "sha256": "98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821",
          "strip": 1
        }
      ],
      "build": [
        "sed -i \"/^r = run_command('git', 'describe', check: false)$/,/^endif$/d\" meson.build",
        "! grep -q \"run_command('git'\" meson.build",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Ddocs=disabled -Dpython=disabled -Dhttp=disabled -Dicu=disabled -Diconv=disabled -Dreadline=disabled -Dhistory=disabled -Dzlib=disabled",
        "meson install -C out"
      ]
    },
    {
      "name": "librsvg",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu", "PYTHONHASHSEED": "0" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/librsvg/2.63/librsvg-2.63.2.tar.xz",
          "sha256": "852b18e1a00b8605528825a27dc7748bff2a5dd254028f59dc22a34ea57e81b6",
          "strip": 1
        }
      ],
      "vendor": {
        "commands": ["cargo vendor --locked vendor >/dev/null"],
        "dir": "vendor",
        "sha256": "5afe2e967193302735afeb9878e3bdb77982dd5ac07f777d6e0af7bace573d9c"
      },
      "build": [
        "mkdir -p .cargo && printf '%s\\n' '[source.crates-io]' 'replace-with = \"vendored\"' '[source.vendored]' 'directory = \"vendor\"' '[net]' 'offline = true' > .cargo/config.toml",
        "sed -i -e \"s/^    nm = find_program('nm')$/    nm = find_program('nm', required: false, disabler: true)/\" -e '/^    link_depends: librsvg_ver,$/d' rsvg/meson.build",
        "grep -q \"find_program('nm', required: false, disabler: true)\" rsvg/meson.build && ! grep -q 'link_depends: librsvg_ver' rsvg/meson.build",
        "sed -i 's/^    link_whole: librsvg_c_lib,$/    link_with: librsvg_c_lib,/' rsvg/meson.build",
        "grep -q '^    link_with: librsvg_c_lib,$' rsvg/meson.build",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dtriplet=x86_64-pc-windows-gnu -Dpixbuf=enabled -Dpixbuf-loader=enabled -Drsvg-convert=enabled -Dintrospection=enabled -Dvala=disabled -Ddocs=disabled -Dtests=false -Davif=disabled",
        "meson install -C out",
        "grep -q 'pixbufloader_svg[.]dll' \"$PREFIX/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache\" && ! grep -q '^\"B:' \"$PREFIX/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache\""
      ]
    },
    {
      "name": "hunspell",
      "env": { "SED": "sed", "GREP": "grep", "EGREP": "grep -E", "FGREP": "grep -F", "AWK": "awk", "AR": "ar", "RANLIB": "ranlib", "CFLAGS": "-O2", "CXXFLAGS": "-O2", "LD": "sh B:/src/hunspell/zigsaw/ld.sh", "LDFLAGS": "-Wl,-s -Wl,-Brepro" },
      "sources": [
        {
          "url": "https://github.com/hunspell/hunspell/releases/download/v1.7.5/hunspell-1.7.5.tar.gz",
          "sha256": "2e559f0c2a592ba48e421477f58e9bf7e01062277a4a7821afb52fc9401010ae",
          "strip": 1
        },
        { "path": "gtk4-sdk/autotools-mtimes.sh", "dest": "zigsaw/mtimes.sh" },
        { "path": "gtk4-sdk/autotools-ld.sh", "dest": "zigsaw/ld.sh" }
      ],
      "build": [
        "sh zigsaw/mtimes.sh",
        "sh ./configure --build=x86_64-w64-mingw32 --host=x86_64-w64-mingw32 --prefix=\"$PREFIX\" --disable-static --disable-nls --without-ui --without-readline lt_cv_deplibs_check_method=pass_all > configure.log 2>&1 || { tail -60 config.log; exit 1; }",
        "sed -i 's/ -shared -nostdlib / -shared /' libtool",
        "make -C src/hunspell -j\"$(nproc)\"",
        "make -C src/hunspell install",
        "make install-pkgconfDATA"
      ]
    },
    {
      "name": "enchant",
      "env": { "SED": "sed", "GREP": "grep", "EGREP": "grep -E", "FGREP": "grep -F", "AWK": "awk", "AR": "ar", "RANLIB": "ranlib", "NM": "nm", "RM": "rm -f", "CFLAGS": "-O2", "CXXFLAGS": "-O2", "LD": "sh B:/src/enchant/zigsaw/ld.sh", "LDFLAGS": "-Wl,-s -Wl,-Brepro", "PKG_CONFIG": "pkg-config", "DOXYGEN": "true" },
      "sources": [
        {
          "url": "https://github.com/rrthomas/enchant/releases/download/v2.8.21/enchant-2.8.21.tar.gz",
          "sha256": "dd2a762697c463148a8f59867089a5ebf2dd1449d869f93764b76c12bcf8acc0",
          "strip": 1
        },
        { "path": "gtk4-sdk/autotools-mtimes.sh", "dest": "zigsaw/mtimes.sh" },
        { "path": "gtk4-sdk/autotools-ld.sh", "dest": "zigsaw/ld.sh" },
        { "path": "gtk4-sdk/implibs.sh", "dest": "zigsaw/implibs.sh" },
        { "path": "gtk4-sdk/enchant.ordering", "dest": "zigsaw/enchant.ordering" }
      ],
      "build": [
        "sh zigsaw/mtimes.sh",
        "sh zigsaw/implibs.sh \"$PREFIX/lib\"",
        "sh ./configure --build=x86_64-w64-mingw32 --host=x86_64-w64-mingw32 --prefix=\"$PREFIX\" --disable-static --enable-relocatable --disable-gcc-warnings --with-hunspell --with-winspell --without-aspell --without-nuspell --without-hspell --without-voikko --without-applespell --without-zemberek lt_cv_deplibs_check_method=pass_all > configure.log 2>&1 || { tail -60 config.log; exit 1; }",
        "grep -q '^#define ENABLE_RELOCATABLE 1' config.h && grep -q '^HUNSPELL_LIBS = .*hunspell' providers/Makefile && grep -q '^WINSPELL_CFLAGS = ..' providers/Makefile",
        "sed -i 's/ -shared -nostdlib / -shared /' libtool",
        "printf '%s\\n' EXPORTS init_enchant_provider > zigsaw/provider.def",
        "make -C libgnu -j\"$(nproc)\"",
        "make -C lib -j\"$(nproc)\" nodist_doc_DATA=",
        "grep -q '^ *enchant_broker_init' lib/.libs/libenchant-2-2.dll.def && ! grep -v -e '^EXPORTS' -e '^ *enchant_' lib/.libs/libenchant-2-2.dll.def | grep -q .",
        "make -C providers -j\"$(nproc)\" LDFLAGS=\"$LDFLAGS -export-symbols B:/src/enchant/zigsaw/provider.def\"",
        "make -C lib install nodist_doc_DATA=",
        "make -C providers install",
        "make install-pkgconfigDATA",
        "cp zigsaw/enchant.ordering \"$PREFIX/share/enchant-2/enchant.ordering\""
      ]
    },
    {
      "name": "hunspell-en-us",
      "sources": [
        { "url": "https://raw.githubusercontent.com/LibreOffice/dictionaries/e7f163feb2beaf526135132d8716e68e19d2716e/en/en_US.aff", "sha256": "e746c882dd6f303c2c46e7452804b9201115a6942cfeb15f18f8edf774d2e24e", "dest": "share/hunspell/en_US.aff" },
        { "url": "https://raw.githubusercontent.com/LibreOffice/dictionaries/e7f163feb2beaf526135132d8716e68e19d2716e/en/en_US.dic", "sha256": "f0b1a234bd178bdd01875b2a392a9647f888b8fe879f79c52aae62c2759b3647", "dest": "share/hunspell/en_US.dic" },
        { "url": "https://raw.githubusercontent.com/LibreOffice/dictionaries/e7f163feb2beaf526135132d8716e68e19d2716e/en/README_en_US.txt", "sha256": "168b4c01cb841f766a72f310b065c04d09cff46376c37a81d799593ce751c371", "dest": "share/doc/hunspell-en-us/README_en_US.txt" }
      ],
      "build": ["mkdir -p \"$PREFIX/share/hunspell\" \"$PREFIX/share/doc/hunspell-en-us\"", "cp -r share \"$PREFIX/\""]
    },
    {
      "name": "implibs",
      "sources": [{ "path": "gtk4-sdk/implibs.sh" }],
      "build": ["sh implibs.sh \"$PREFIX/lib\""]
    }
  ]
}
