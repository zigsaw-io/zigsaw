{
  "id": "net.php.php.Zstd",
  "version": "0.18.0",
  "name": "Zstandard for PHP 8.5",
  "summary": "zstd, Zstandard compression for PHP, as an extension built with zig, with libzstd built in; once installed, PHP loads it",
  "homepage": "https://pecl.php.net/package/zstd",
  "license": "MIT AND (BSD-3-Clause OR GPL-2.0-only)",
  "command": "about.bat",
  "env": { "PHP_EXT_ZSTD": "${app}", "PHP_INI_SCAN_DIR": "${app}\\conf.d" },
  "extends": { "point": "net.php.php", "version": "API20250925,NTS,VS17" },
  "exports": {},
  "sdk": {
    "phpsdk": "net.php.php.Sdk:8.5.11@sha256:095dc2d756745242ac59c0609bcf858f0b883d9d0ae77ee99cef4569e1cf8edb",
    "cmake": "org.cmake.cmake:4.4.4@sha256:fdc6a6bb933b2d7994fba0ccdb07a2a91a02012a6e4879cf67ad451e53e6f53d"
  },
  "cleanup": ["/include", "/lib/cmake", "/lib/pkgconfig", "/lib/libzstd.a"],
  "modules": [
    {
      "name": "libzstd",
      "sources": [
        {
          "url": "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz",
          "sha256": "eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S build/cmake -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" -DZSTD_BUILD_SHARED=OFF -DZSTD_BUILD_PROGRAMS=OFF -DZSTD_BUILD_TESTS=OFF",
        "cmake --build out",
        "cmake --install out",
        "cp LICENSE \"$PREFIX/LICENSE.libzstd\""
      ]
    },
    {
      "name": "zstd",
      "sources": [
        {
          "url": "https://pecl.php.net/get/zstd-0.18.0.tgz",
          "sha256": "223d0f77eb5a5e73cf5e7a0652dd8fde7ffdcc843e7f30eeb3998283dec847b9",
          "strip": 1
        }
      ],
      "build": ["php-ext build --enable-zstd", "cp LICENSE \"$PREFIX/LICENSE\""]
    }
  ]
}
