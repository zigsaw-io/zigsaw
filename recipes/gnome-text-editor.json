{
  "id": "org.gnome.TextEditor",
  "version": "51.0",
  "command": "bin/gnome-text-editor.exe",
  "path": ["bin"],
  "permissions": { "filesystem": ["cwd"] },
  "exports": {
    "gnome-text-editor": { "command": "bin/gnome-text-editor.exe" }
  },
  "shortcuts": {
    "Text Editor": { "command": "gnome-text-editor", "description": "View and edit text files" }
  },
  "runtimes": {
    "gtk": "org.gtk.Gtk4:4.24.1@sha256:f7df3f771a48452eba015e81f6fc31590f790f48af80d73420e7139e69c637e3"
  },
  "sdk": {
    "gtksdk": "org.gtk.Gtk4.Sdk:4.24.1@sha256:c5756c4806e9718c173a3478bfbd9a60ff0fa3d5da5c7aa847d0d6faabc41cb7",
    "meson": "com.mesonbuild.meson:1.12.1@sha256:9f1660936c3c00e44f1b90a83c72f20a28023b8f5f85bb61505f33c00ef4f767",
    "cmake": "org.cmake.cmake:4.4.4@sha256:fdc6a6bb933b2d7994fba0ccdb07a2a91a02012a6e4879cf67ad451e53e6f53d",
    "zig": "org.ziglang.zig:0.16.0@sha256:0379659d0e7a87ac7912ea6bd12fc929f889b554706e91299c8063235afea355",
    "busybox": "net.frippery.busybox:FRP-6075-g169694ebd@sha256:db9d39727bfdd4d176b5878c0a125daa8a2396ea21e0f01a6a372f53d9d97e5d"
  },
  "cleanup": [
    "/include",
    "/lib",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/aclocal",
    "/bin/editorconfig.exe",
    "/bin/editorconfig-*.exe",
    "*-config"
  ],
  "modules": [
    {
      "name": "crt-noexport",
      "build": [
        "printf '%s\\n' '.section .drectve' '.ascii \" -exclude-symbols:atexit,_CRT_INIT,__mingw_module_is_dll\"' > noexport.s",
        "cc -c noexport.s -o noexport.o"
      ]
    },
    {
      "name": "gtksourceview",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/gtksourceview/5.22/gtksourceview-5.22.0.tar.xz",
          "sha256": "3ebce33c781e65590a450ecd3ffade480d8e3135b52ee996f1620d6c7dffbbff",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dbuild-testsuite=false -Dintrospection=disabled -Dvapi=false -Ddocumentation=false -Dsysprof=false",
        "meson install -C out"
      ]
    },
    {
      "name": "libspelling",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/libspelling/0.4/libspelling-0.4.10.tar.xz",
          "sha256": "56e3f01a3a18b575beea4c34349f99cdaba316e1f7c271b1231f7bcf5d9af73b",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Denchant=disabled -Ddocs=false -Dintrospection=disabled -Dvapi=false -Dsysprof=false",
        "meson install -C out"
      ]
    },
    {
      "name": "editorconfig",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o" },
      "sources": [
        {
          "url": "https://github.com/editorconfig/editorconfig-core-c/archive/refs/tags/v0.12.11.tar.gz",
          "sha256": "9d8b420b56a969ea3cf784861c72d26fa0e158fa1494d732df2c8a1480d36a5c",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DBUILD_DOCUMENTATION=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "gnome-text-editor",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/gnome-text-editor/51/gnome-text-editor-51.0.tar.xz",
          "sha256": "2b76e6da1506346c54b36ba1a3aeedcd28f4cb7d6a8793d217f209456c92dd4c",
          "strip": 1
        }
      ],
      "build": [
        "sed -i \"/^subdir('help')$/d\" meson.build",
        "! grep -q \"subdir('help')\" meson.build",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release",
        "meson install -C out"
      ]
    }
  ]
}
