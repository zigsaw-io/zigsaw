{
  "id": "org.gdal.GDAL",
  "version": "3.13.3",
  "name": "GDAL",
  "summary": "GDAL's raster and vector tools (gdal, gdalinfo, gdal_translate, gdalwarp, ogr2ogr and the rest), built with zig on GEOS, PROJ and SQLite",
  "homepage": "https://gdal.org/",
  "license": "MIT AND LGPL-2.1-or-later AND blessing AND Zlib AND libtiff AND IJG AND libpng-2.0 AND Apache-2.0 AND Qhull",
  "command": "bin/gdal.exe",
  "path": ["bin"],
  "env": { "GDAL_DATA": "${app}\\share\\gdal", "PROJ_DATA": "${app}\\share\\proj" },
  "permissions": { "filesystem": ["cwd"] },
  "exports": {
    "gdal": { "command": "bin/gdal.exe" },
    "gdalinfo": { "command": "bin/gdalinfo.exe" },
    "gdal_translate": { "command": "bin/gdal_translate.exe" },
    "gdalwarp": { "command": "bin/gdalwarp.exe" },
    "gdaladdo": { "command": "bin/gdaladdo.exe" },
    "gdalbuildvrt": { "command": "bin/gdalbuildvrt.exe" },
    "gdal_contour": { "command": "bin/gdal_contour.exe" },
    "gdal_create": { "command": "bin/gdal_create.exe" },
    "gdal_footprint": { "command": "bin/gdal_footprint.exe" },
    "gdal_grid": { "command": "bin/gdal_grid.exe" },
    "gdal_rasterize": { "command": "bin/gdal_rasterize.exe" },
    "gdal_viewshed": { "command": "bin/gdal_viewshed.exe" },
    "gdaldem": { "command": "bin/gdaldem.exe" },
    "gdalenhance": { "command": "bin/gdalenhance.exe" },
    "gdallocationinfo": { "command": "bin/gdallocationinfo.exe" },
    "gdalmanage": { "command": "bin/gdalmanage.exe" },
    "gdalmdiminfo": { "command": "bin/gdalmdiminfo.exe" },
    "gdalmdimtranslate": { "command": "bin/gdalmdimtranslate.exe" },
    "gdalsrsinfo": { "command": "bin/gdalsrsinfo.exe" },
    "gdaltindex": { "command": "bin/gdaltindex.exe" },
    "gdaltransform": { "command": "bin/gdaltransform.exe" },
    "nearblack": { "command": "bin/nearblack.exe" },
    "ogr2ogr": { "command": "bin/ogr2ogr.exe" },
    "ogrinfo": { "command": "bin/ogrinfo.exe" },
    "ogrlineref": { "command": "bin/ogrlineref.exe" },
    "ogrtindex": { "command": "bin/ogrtindex.exe" },
    "gnmanalyse": { "command": "bin/gnmanalyse.exe" },
    "gnmmanage": { "command": "bin/gnmmanage.exe" },
    "sozip": { "command": "bin/sozip.exe" }
  },
  "sdk": {
    "gdalsdk": "org.gdal.GDAL.Sdk:3.13.3@sha256:4e13cd0a2a0187c5c04f23d9b6428586e2c49f2129245ce60ae217f8d2f2b51d"
  },
  "cleanup": ["/include", "/lib", "/bin/gdal-config", "/bin/geos-config", "/bin/sqlite3.exe", "/bin/iconv.exe"],
  "modules": [
    {
      "name": "gdal",
      "sources": [{ "image": "org.gdal.GDAL.Sdk:3.13.3@sha256:4e13cd0a2a0187c5c04f23d9b6428586e2c49f2129245ce60ae217f8d2f2b51d" }]
    }
  ]
}
