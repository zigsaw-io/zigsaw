{
  "id": "dev.zotregistry.zot",
  "version": "2.1.23",
  "name": "zot",
  "summary": "An OCI image registry, its minimal build",
  "homepage": "https://zotregistry.dev/",
  "license": "Apache-2.0",
  "command": "zot.exe",
  "permissions": { "network": true, "filesystem": ["cwd"] },
  "sdk": {
    "go": "org.golang.go:1.27.3@sha256:fb6554b0d89f578112c72b92c87a05583980578328180762571770884b3bc162",
    "busybox": "net.frippery.busybox:FRP-6075-g169694ebd@sha256:db9d39727bfdd4d176b5878c0a125daa8a2396ea21e0f01a6a372f53d9d97e5d"
  },
  "modules": [
    {
      "name": "zot",
      "sources": [
        {
          "url": "https://proxy.golang.org/zotregistry.dev/zot/v2/@v/v2.1.23.zip",
          "sha256": "f1aec50428799c1fe26cba26086bd0b4418c63515f15a05ed0b5d6af849a712f",
          "strip": 3
        }
      ],
      "env": { "CGO_ENABLED": "0", "GOEXPERIMENT": "jsonv2" },
      "vendor": {
        "commands": [
          "go mod vendor",
          "go list -deps -f '{{if and .Module (not .Module.Main)}}{{.ImportPath}}{{end}}' ./cmd/zot >packages.txt",
          "go list -deps -f '{{if and .Module (not .Module.Main)}}{{range .EmbedFiles}}{{$.ImportPath}}/{{.}} {{end}}{{end}}' ./cmd/zot | tr ' ' '\\n' | grep . >embeds.txt || true",
          "for p in $(cat packages.txt); do for f in vendor/$p/*; do [ -f \"$f\" ] && echo \"$f\"; done; done >files.txt",
          "sed 's|^|vendor/|' embeds.txt >>files.txt",
          "mkdir minimal && tar -cf - vendor/modules.txt -T files.txt | tar -xf - -C minimal",
          "rm -rf vendor packages.txt embeds.txt files.txt && mv minimal/vendor vendor && rmdir minimal"
        ],
        "dir": "vendor",
        "sha256": "4f97e4112de0bf144d8f6851e81556e9f698f7ab1fe651bc405aa927a5d75fca"
      },
      "build": [
        "go build -mod=vendor -buildmode=pie -ldflags '-X zotregistry.dev/zot/v2/pkg/buildinfo.ReleaseTag=v2.1.23 -X zotregistry.dev/zot/v2/pkg/buildinfo.Commit=v2.1.23-0-gd7915e8 -X zotregistry.dev/zot/v2/pkg/buildinfo.BinaryType=minimal -X zotregistry.dev/zot/v2/pkg/buildinfo.GoVersion=go1.27.3 -s -w' -o \"$PREFIX/zot.exe\" ./cmd/zot",
        "cp LICENSE README.md \"$PREFIX/\""
      ]
    }
  ]
}
