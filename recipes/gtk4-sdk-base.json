{
  "id": "org.gtk.Gtk4.Sdk.Base",
  "version": "4.24.1",
  "name": "GTK SDK base",
  "summary": "The first half of GTK's SDK (org.gtk.Gtk4.Sdk): GTK 4 and the stack below it, built apart so that CI builds the two halves at once",
  "homepage": "https://www.gtk.org/",
  "license": "LGPL-2.1-or-later",
  "command": "bin/gtk4-demo.exe",
  "path": ["bin"],
  "env": {
    "PKG_CONFIG_PATH": "${app}\\lib\\pkgconfig;${app}\\share\\pkgconfig",
    "RC": "rc /:auto-includes gnu"
  },
  "permissions": { "filesystem": ["cwd"] },
  "exports": {},
  "cleanup": ["__pycache__"],
  "sdk": {
    "cmake": "org.cmake.cmake:4.4.4@sha256:fdc6a6bb933b2d7994fba0ccdb07a2a91a02012a6e4879cf67ad451e53e6f53d",
    "perl": "org.perl.perl:5.42.3.1@sha256:4459f0a9487860f976ef170b4e55c10e4889b2eff314c9eaacf4c42135406773",
    "rust": "org.rust-lang.rust:1.99.0@sha256:e7e9706485bba88759915d9509993d0e41d340d7d8dfec6426fce1feda9a10e2",
    "cargo-c": "com.github.lu-zero.cargo-c:0.10.25@sha256:5c3ab8267b4c4a8f4a1628ef7f0d8f62f9838a28f46df2800a13f542e71bed71"
  },
  "runtimes": {
    "meson": "com.mesonbuild.meson:1.12.1@sha256:9f1660936c3c00e44f1b90a83c72f20a28023b8f5f85bb61505f33c00ef4f767",
    "zig": "org.ziglang.zig:0.16.0@sha256:0379659d0e7a87ac7912ea6bd12fc929f889b554706e91299c8063235afea355",
    "busybox": "net.frippery.busybox:FRP-6075-g169694ebd@sha256:db9d39727bfdd4d176b5878c0a125daa8a2396ea21e0f01a6a372f53d9d97e5d"
  },
  "modules": [
    {
      "name": "crt-noexport",
      "build": [
        "printf '%s\\n' '.section .drectve' '.ascii \" -exclude-symbols:atexit,_CRT_INIT,__mingw_module_is_dll\"' > noexport.s",
        "cc -c noexport.s -o noexport.o"
      ]
    },
    {
      "name": "windres",
      "sources": [{ "path": "gtk4-sdk/windres.c" }],
      "build": [
        "mkdir -p \"$PREFIX/bin\"",
        "cc -O2 -s -municode windres.c -o \"$PREFIX/bin/windres.exe\""
      ]
    },
    {
      "name": "nm",
      "sources": [{ "path": "gtk4-sdk/nm.c" }],
      "build": [
        "cc -O2 -s nm.c -o \"$PREFIX/bin/nm.exe\"",
        "nm \"$PREFIX/bin/nm.exe\" 2>&1 | grep -q 'no symbols$'"
      ]
    },
    {
      "name": "zlib",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o" },
      "sources": [
        {
          "url": "https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.xz",
          "sha256": "d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DZLIB_BUILD_TESTING=OFF -DZLIB_BUILD_STATIC=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "libpng",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o" },
      "sources": [
        {
          "url": "https://github.com/pnggroup/libpng/archive/v1.6.49.tar.gz",
          "sha256": "e425762fdfb9bb30a5d2da29c0067570e96b5d41d79c659cf0dad861e9df738e",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DPNG_STATIC=OFF -DPNG_TESTS=OFF -DPNG_TOOLS=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "libjpeg-turbo",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o" },
      "sources": [
        {
          "url": "https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/3.1.1/libjpeg-turbo-3.1.1.tar.gz",
          "sha256": "aadc97ea91f6ef078b0ae3a62bba69e008d9a7db19b34e4ac973b19b71b4217c",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DENABLE_STATIC=OFF -DWITH_SIMD=OFF -DWITH_TURBOJPEG=OFF -DWITH_TESTS=OFF -DWITH_TOOLS=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "libtiff",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o" },
      "sources": [
        {
          "url": "https://download.osgeo.org/libtiff/tiff-4.7.0.tar.xz",
          "sha256": "273a0a73b1f0bed640afee4a5df0337357ced5b53d3d5d1c405b936501f71017",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -Dtiff-tools=OFF -Dtiff-tests=OFF -Dtiff-contrib=OFF -Dtiff-docs=OFF -Dcxx=OFF -Djbig=OFF -Dlerc=OFF -Dlzma=OFF -Dzstd=OFF -Dwebp=OFF -Dlibdeflate=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "pcre2",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o" },
      "sources": [
        {
          "url": "https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.46/pcre2-10.46.tar.gz",
          "sha256": "8d28d7f2c3b970c3a4bf3776bcbb5adfc923183ce74bc8df1ebaad8c1985bd07",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DBUILD_SHARED_LIBS=ON -DBUILD_STATIC_LIBS=OFF -DPCRE2_BUILD_TESTS=OFF -DPCRE2_BUILD_PCRE2GREP=OFF -DPCRE2_SUPPORT_JIT=ON",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "libffi",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu", "CFLAGS": "-s" },
      "sources": [
        {
          "url": "https://github.com/libffi/libffi/releases/download/v3.5.2/libffi-3.5.2.tar.gz",
          "sha256": "f3a3082a23b37c293a4fcd1053147b371f2ff91fa7ea1b2a52e335676bac82dc",
          "strip": 1
        },
        {
          "url": "https://wrapdb.mesonbuild.com/v2/libffi_3.5.2-1/get_patch",
          "sha256": "1ee3035d92e4df3541d0b2b8d192d2fa183b46e4a3d68c00d8f71ede354bee74",
          "type": "zip",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release --default-library=static -Dtests=false",
        "meson install -C out"
      ]
    },
    {
      "name": "mingw-w64-winrt",
      "sources": [
        {
          "url": "https://github.com/mingw-w64/mingw-w64/archive/refs/tags/v13.0.0.tar.gz",
          "sha256": "1a910473313a329316025fa4563160deae378884e4b8ee573d1d03ac006b2e61",
          "strip": 1
        }
      ],
      "build": [
        "mkdir -p \"$PREFIX/include/mingw-w64-winrt\"",
        "cd mingw-w64-headers/include && cp windows.*.h eventtoken.h windowscontracts.h ivectorchangedeventargs.h \"$PREFIX/include/mingw-w64-winrt/\""
      ]
    },
    {
      "name": "gettext",
      "sources": [{ "image": "org.gnu.gettext:1.0@sha256:f3f85ba59c5cb8607358ae8c04ae78979772ce6e6df87080b0e77cd998387e8e" }]
    },
    {
      "name": "glib",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o -LB:/prefix/lib", "RC": "rc /:auto-includes gnu", "CFLAGS": "-IB:/prefix/include/mingw-w64-winrt", "CPPFLAGS": "-IB:/prefix/include" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/glib/2.90/glib-2.90.0.tar.xz",
          "sha256": "17d15cac2af80a33271127408e0abc2748eb297c595c2a26409e81e14e7d1b8f",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dtests=false -Dintrospection=disabled -Dman-pages=disabled -Ddocumentation=false -Dsysprof=disabled -Dnls=enabled",
        "meson install -C out",
        "grep -q libintl-8.dll \"$PREFIX/bin/libglib-2.0-0.dll\""
      ]
    },
    {
      "name": "pixman",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://cairographics.org/releases/pixman-0.46.4.tar.xz",
          "sha256": "a098c33924754ad43f981b740f6d576c70f9ed1006e12221b1845431ebce1239",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dtests=disabled -Ddemos=disabled -Dgtk=disabled -Dlibpng=disabled -Dopenmp=disabled -Dtimers=false -Dgnuplot=false",
        "meson install -C out"
      ]
    },
    {
      "name": "fribidi",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://github.com/fribidi/fribidi/releases/download/v1.0.16/fribidi-1.0.16.tar.xz",
          "sha256": "1b1cde5b235d40479e91be2f0e88a309e3214c8ab470ec8a2744d82a5a9ea05c",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Ddocs=false -Dbin=false -Dtests=false",
        "meson install -C out"
      ]
    },
    {
      "name": "cairo",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu", "CFLAGS": "-Wno-error=date-time" },
      "sources": [
        {
          "url": "https://cairographics.org/releases/cairo-1.18.6.tar.xz",
          "sha256": "1c767308174337a74694da0f3ec069c271452163a1ef4540964c50c301f157d4",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Ddwrite=enabled -Dfontconfig=disabled -Dfreetype=disabled -Dpng=enabled -Dzlib=enabled -Dglib=enabled -Dquartz=disabled -Dxcb=disabled -Dxlib=disabled -Dxlib-xcb=disabled -Dtests=disabled -Dgtk2-utils=disabled -Dspectre=disabled -Dsymbol-lookup=disabled -Dgtk_doc=false",
        "meson install -C out"
      ]
    },
    {
      "name": "python",
      "sources": [
        {
          "url": "https://www.nuget.org/api/v2/package/python/3.14.7",
          "sha256": "46a4da5529a92d18ff894911f6e6033a8253198d705b8161bf28c9123c87d46b",
          "type": "zip",
          "dest": "nupkg"
        },
        {
          "url": "https://files.pythonhosted.org/packages/95/9c/c510029fc6ef33a6275cd2c5d3cecd6613dfd6aa401d57c54f1c18852ccf/setuptools-84.0.0-py3-none-any.whl",
          "sha256": "51a52592b3b99e102b609654876bd65f19f999935166d1352678931132b0c670",
          "type": "zip",
          "dest": "setuptools"
        }
      ],
      "build": [
        "mkdir -p \"$PREFIX/python\"",
        "cp -r nupkg/tools/. \"$PREFIX/python/\"",
        "cp -r setuptools/. \"$PREFIX/python/Lib/site-packages/\"",
        "\"$PREFIX/python/python.exe\" -B -c 'import distutils.cygwinccompiler'"
      ]
    },
    {
      "name": "flex-bison",
      "sources": [
        {
          "url": "https://github.com/lexxmark/winflexbison/releases/download/v2.5.25/win_flex_bison-2.5.25.zip",
          "sha256": "8d324b62be33604b2c45ad1dd34ab93d722534448f55a16ca7292de32b6ac135"
        }
      ],
      "build": ["./win_flex.exe --version && ./win_bison.exe --version"]
    },
    {
      "name": "gobject-introspection",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/gobject-introspection/1.86/gobject-introspection-1.86.0.tar.xz",
          "sha256": "920d1a3fcedeadc32acff95c2e203b319039dd4b4a08dd1a2dfd283d19c0b9ae",
          "strip": 1
        },
        { "path": "gtk4-sdk/gobject-introspection.patch", "dest": "zigsaw/gobject-introspection.patch" },
        { "path": "gtk4-sdk/python-script.c", "dest": "zigsaw/python-script.c" },
        { "path": "gtk4-sdk/implibs.sh", "dest": "zigsaw/implibs.sh" }
      ],
      "build": [
        "patch -p1 < zigsaw/gobject-introspection.patch",
        "sh zigsaw/implibs.sh \"$PREFIX/lib\"",
        "PATH=\"B:/src/flex-bison;$PATH\" meson setup out --prefix=\"$PREFIX\" --buildtype=release \"-Dpython=$PREFIX/python/python.exe\" -Dcairo=enabled -Ddoctool=disabled -Dgtk_doc=false -Dtests=false",
        "meson install -C out",
        "cc -O2 -s -municode zigsaw/python-script.c -o \"$PREFIX/bin/g-ir-scanner.exe\"",
        "cp \"$PREFIX/bin/g-ir-scanner.exe\" \"$PREFIX/bin/g-ir-annotation-tool.exe\"",
        "sed -i 's|^g_ir_scanner=${bindir}/g-ir-scanner$|g_ir_scanner=${bindir}/g-ir-scanner.exe|' \"$PREFIX/lib/pkgconfig/gobject-introspection-1.0.pc\"",
        "grep -q '^g_ir_scanner=${bindir}/g-ir-scanner.exe$' \"$PREFIX/lib/pkgconfig/gobject-introspection-1.0.pc\"",
        "\"$PREFIX/bin/g-ir-scanner.exe\" --version"
      ]
    },
    {
      "name": "glib-introspection",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o -LB:/prefix/lib", "RC": "rc /:auto-includes gnu", "CFLAGS": "-IB:/prefix/include/mingw-w64-winrt", "CPPFLAGS": "-IB:/prefix/include" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/glib/2.90/glib-2.90.0.tar.xz",
          "sha256": "17d15cac2af80a33271127408e0abc2748eb297c595c2a26409e81e14e7d1b8f",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dtests=false -Dintrospection=enabled -Dman-pages=disabled -Ddocumentation=false -Dsysprof=disabled -Dnls=enabled",
        "meson install -C out",
        "ls \"$PREFIX/lib/girepository-1.0/GLib-2.0.typelib\" \"$PREFIX/lib/girepository-1.0/Gio-2.0.typelib\""
      ]
    },
    {
      "name": "harfbuzz",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://github.com/harfbuzz/harfbuzz/releases/download/14.4.0/harfbuzz-14.4.0.tar.xz",
          "sha256": "2357ed966c6ced7bfa720b0640c0231065af01158fbea215093ffa15aed44371",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dglib=enabled -Dgobject=enabled -Dcairo=disabled -Dchafa=disabled -Dicu=disabled -Dfreetype=disabled -Dgdi=enabled -Ddirectwrite=enabled -Dtests=disabled -Dintrospection=enabled -Ddocs=disabled -Dutilities=disabled -Dbenchmark=disabled",
        "meson install -C out"
      ]
    },
    {
      "name": "pango",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/pango/1.58/pango-1.58.2.tar.xz",
          "sha256": "342385b6ca3b7c73455d7c80a13b7dbe4489e00bc3bd4c5bd6ed4dce421e374a",
          "strip": 1
        }
      ],
      "build": [
        "sed -i 's/^\\(              pango_font_description_set_gravity (new_desc,\\)$/              pango_font_description_set_color (new_desc, pango_font_description_get_color (description));\\n\\1/' pango/pangowin32-fontmap.c",
        "grep -q '^              pango_font_description_set_color (new_desc, pango_font_description_get_color (description));$' pango/pangowin32-fontmap.c",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dcairo=enabled -Dfontconfig=disabled -Dfreetype=disabled -Dxft=disabled -Dlibthai=disabled -Dintrospection=enabled -Ddocumentation=false -Dman-pages=false -Dbuild-testsuite=false -Dbuild-examples=false -Dsysprof=disabled",
        "meson install -C out"
      ]
    },
    {
      "name": "graphene",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/graphene/1.10/graphene-1.10.8.tar.xz",
          "sha256": "a37bb0e78a419dcbeaa9c7027bcff52f5ec2367c25ec859da31dfde2928f279a",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dgobject_types=true -Dintrospection=enabled -Dtests=false -Dinstalled_tests=false -Dgtk_doc=false",
        "meson install -C out"
      ]
    },
    {
      "name": "libepoxy",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/libepoxy/1.5/libepoxy-1.5.10.tar.xz",
          "sha256": "072cda4b59dd098bba8c2363a6247299db1fa89411dc221c8b81b8ee8192e623",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Ddocs=false -Dglx=no -Degl=no -Dx11=false -Dtests=false",
        "meson install -C out"
      ]
    },
    {
      "name": "gdk-pixbuf",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/gdk-pixbuf/2.43/gdk-pixbuf-2.43.3.tar.xz",
          "sha256": "ed4c5d16346a5b4e95326731de9700fad70d03bbd2f9324732e6c94f42d869d7",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dpng=enabled -Djpeg=enabled -Dtiff=enabled -Dgif=enabled -Dglycin=disabled -Dothers=disabled -Dbuiltin_loaders=all -Drelocatable=true -Dintrospection=enabled -Dman=false -Dgtk_doc=false -Ddocumentation=false -Dtests=false -Dinstalled_tests=false -Dgio_sniffing=false -Dthumbnailer=disabled",
        "meson install -C out"
      ]
    },
    {
      "name": "directx-headers",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu", "CFLAGS": "-s", "CXXFLAGS": "-s" },
      "sources": [
        {
          "url": "https://github.com/microsoft/DirectX-Headers/archive/refs/tags/v1.611.0.tar.gz",
          "sha256": "edb8b52b1379f841df5d0d5e11dde08e0c3912508179fb3711f163382e88865c",
          "strip": 1
        }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dbuild-test=false",
        "meson install -C out"
      ]
    },
    {
      "name": "gtk",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "RC": "rc /:auto-includes gnu /:output-format coff", "CFLAGS": "-DCROARING_COMPILER_SUPPORTS_AVX512=0" },
      "sources": [
        {
          "url": "https://download.gnome.org/sources/gtk/4.24/gtk-4.24.1.tar.xz",
          "sha256": "e98abe720e16129c8c0f50761dee0a2e9ae2478055e31018f6cf977fcf6513e9",
          "strip": 1
        },
        { "path": "gtk4-sdk/gtk-ime-filter.patch", "dest": "zigsaw/ime-filter.patch" }
      ],
      "build": [
        "patch -p1 < zigsaw/ime-filter.patch",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dwin32-backend=true -Dx11-backend=false -Dwayland-backend=false -Dmacos-backend=false -Dmedia-gstreamer=disabled -Dvulkan=disabled -Dintrospection=enabled -Daccesskit=disabled -Dprint-cpdb=disabled -Dcolord=disabled -Dsysprof=disabled -Dcloudproviders=disabled -Dtracker=disabled -Ddocumentation=false -Dman-pages=false -Dbuild-demos=true -Dbuild-examples=false -Dbuild-tests=false -Dbuild-testsuite=false",
        "meson install -C out"
      ]
    }
  ]
}
