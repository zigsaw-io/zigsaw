{
  "id": "io.qt.Qt6.Sdk",
  "version": "6.12.0",
  "name": "Qt 6 SDK",
  "summary": "Qt 6's Widgets set built with zig (qtbase, qtsvg, qtimageformats, qttools, qttranslations), with CMake, Ninja and zig's compilers for building Qt apps",
  "homepage": "https://www.qt.io/",
  "license": "LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only",
  "command": "bin/qtpaths.exe",
  "path": ["bin"],
  "env": {
    "CMAKE_PREFIX_PATH": "${app}",
    "RC": "rc /:auto-includes gnu"
  },
  "permissions": { "filesystem": ["cwd"] },
  "exports": {
    "cc": { "command": "${zig}/zig.exe", "args": ["cc", "-target", "x86_64-windows-gnu"] },
    "c++": { "command": "${zig}/zig.exe", "args": ["c++", "-target", "x86_64-windows-gnu"] },
    "ar": { "command": "${zig}/zig.exe", "args": ["ar"] },
    "rc": { "command": "${zig}/zig.exe", "args": ["rc", "/:auto-includes", "gnu"] },
    "cmake": { "command": "${cmake}/bin/cmake.exe" },
    "ninja": { "command": "${cmake}/bin/ninja.exe" },
    "sh": { "command": "${busybox}/busybox.exe", "args": ["sh"] },
    "make": { "command": "${busybox}/busybox.exe", "args": ["make"] },
    "qmake": { "command": "bin/qmake.exe" },
    "qtpaths": { "command": "bin/qtpaths.exe" },
    "lupdate": { "command": "bin/lupdate.exe" },
    "lrelease": { "command": "bin/lrelease.exe" },
    "designer": { "command": "bin/designer.exe" }
  },
  "cleanup": ["*.bat"],
  "runtimes": {
    "cmake": "org.cmake.cmake:4.4.4@sha256:fdc6a6bb933b2d7994fba0ccdb07a2a91a02012a6e4879cf67ad451e53e6f53d",
    "zig": "org.ziglang.zig:0.16.0@sha256:0379659d0e7a87ac7912ea6bd12fc929f889b554706e91299c8063235afea355",
    "busybox": "net.frippery.busybox:FRP-6075-g169694ebd@sha256:db9d39727bfdd4d176b5878c0a125daa8a2396ea21e0f01a6a372f53d9d97e5d"
  },
  "modules": [
    {
      "name": "crt-noexport",
      "build": [
        "printf '%s\\n' '.section .drectve' '.ascii \" -exclude-symbols:atexit,_CRT_INIT,__mingw_module_is_dll\"' > noexport.s",
        "cc -c noexport.s -o noexport.o"
      ]
    },
    {
      "name": "winlibs",
      "sources": [{ "path": "qt6-sdk/winlibs.sh" }],
      "build": ["sh winlibs.sh B:/src/winlibs"]
    },
    {
      "name": "qtbase",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o -LB:/src/winlibs", "CFLAGS": "-s", "CXXFLAGS": "-s" },
      "sources": [
        {
          "url": "https://github.com/qt/qtbase/archive/refs/tags/v6.12.0.tar.gz",
          "sha256": "dff6570582c272cbe744d2e460700318262af505460f4215276459970ae31b46",
          "strip": 1
        },
        { "path": "qt6-sdk/qtbase.sh", "dest": "zigsaw/qtbase.sh" },
        { "path": "qt6-sdk/qlocalserver-appcontainer.patch", "dest": "zigsaw/qlocalserver-appcontainer.patch" }
      ],
      "build": [
        "sh zigsaw/qtbase.sh",
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF -DQT_BUILD_BENCHMARKS=OFF -DBUILD_WITH_PCH=OFF -DFEATURE_dbus=OFF -DFEATURE_openssl=OFF -DFEATURE_icu=OFF -DFEATURE_system_zlib=OFF -DFEATURE_system_png=OFF -DFEATURE_system_jpeg=OFF -DFEATURE_system_harfbuzz=OFF -DFEATURE_system_pcre2=OFF -DFEATURE_system_freetype=OFF -DFEATURE_system_doubleconversion=OFF -DFEATURE_system_md4c=OFF -DFEATURE_system_sqlite=OFF -DQT_GENERATE_SBOM=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "qtsvg",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "CFLAGS": "-s", "CXXFLAGS": "-s" },
      "sources": [
        {
          "url": "https://github.com/qt/qtsvg/archive/refs/tags/v6.12.0.tar.gz",
          "sha256": "38d440c4e97c90ce4f5b76c65dcd63d716d2ef4852baa6fb0926fb94bb96ea66",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF -DBUILD_WITH_PCH=OFF -DQT_GENERATE_SBOM=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "qtimageformats",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "CFLAGS": "-s", "CXXFLAGS": "-s" },
      "sources": [
        {
          "url": "https://github.com/qt/qtimageformats/archive/refs/tags/v6.12.0.tar.gz",
          "sha256": "9848d06aa4453cf583dc6ec4ec148ade05f3981c0f91b0961297385d3297b02a",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF -DBUILD_WITH_PCH=OFF -DQT_GENERATE_SBOM=OFF -DFEATURE_system_tiff=OFF -DFEATURE_system_webp=OFF -DFEATURE_jasper=OFF -DFEATURE_mng=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "qttools",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "CFLAGS": "-s", "CXXFLAGS": "-s" },
      "sources": [
        {
          "url": "https://github.com/qt/qttools/archive/refs/tags/v6.12.0.tar.gz",
          "sha256": "eff0ab495ca82147052ed7a2e92cc222a6171ae28f7d0a11aa867054139092cf",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF -DBUILD_WITH_PCH=OFF -DQT_GENERATE_SBOM=OFF -DFEATURE_assistant=OFF -DFEATURE_clang=OFF -DFEATURE_qdoc=OFF -DFEATURE_qdbus=OFF -DFEATURE_distancefieldgenerator=OFF -DFEATURE_qtattributionsscanner=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "qttranslations",
      "env": { "LDFLAGS": "-s -Wl,-Brepro B:/src/crt-noexport/noexport.o", "CFLAGS": "-s", "CXXFLAGS": "-s" },
      "sources": [
        {
          "url": "https://github.com/qt/qttranslations/archive/refs/tags/v6.12.0.tar.gz",
          "sha256": "8be0626ad9c84b09a64ab521e5049bbd009f1335c2283c996954736c7e71484d",
          "strip": 1
        }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" \"-DCMAKE_RC_FLAGS=/:auto-includes gnu\" -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF -DBUILD_WITH_PCH=OFF -DQT_GENERATE_SBOM=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "relocate",
      "build": [
        "sed -i 's|^prefix=B:/prefix$|prefix=${pcfiledir}/../..|' \"$PREFIX\"/lib/pkgconfig/*.pc",
        "! grep -l 'B:/prefix' \"$PREFIX\"/lib/pkgconfig/*.pc"
      ]
    }
  ]
}
