{
  "id": "net.php.php.Sdk",
  "version": "8.5.11",
  "name": "PHP SDK",
  "summary": "PHP 8.5 with its headers and those of the libraries it ships, and php-ext to build extensions with zig; needs the Visual C++ Redistributable",
  "homepage": "https://www.php.net/",
  "license": "PHP-3.01",
  "command": "php.exe",
  "env": { "PHPRC": "${app}", "SSL_CERT_FILE": "${roots}" },
  "permissions": { "network": true, "filesystem": ["cwd"] },
  "runtimes": {
    "zig": "org.ziglang.zig:0.16.0@sha256:0379659d0e7a87ac7912ea6bd12fc929f889b554706e91299c8063235afea355",
    "busybox": "net.frippery.busybox:FRP-6075-g169694ebd@sha256:db9d39727bfdd4d176b5878c0a125daa8a2396ea21e0f01a6a372f53d9d97e5d",
    "node": "org.nodejs.node:24.21.0@sha256:3f86c9ebda5d5b84abd3551eccc834102e7f9934ce5c64e19ca557fe82e8c6cb"
  },
  "aliases": {
    "php-ext": { "command": "php.exe", "args": ["${app}\\dev\\zigsaw\\php-ext.php"] }
  },
  "exports": {
    "php-ext": { "command": "php.exe", "args": ["${app}\\dev\\zigsaw\\php-ext.php"] }
  },
  "cleanup": [
    "/dev/php8.lib",
    "/dev/phpize.bat",
    "/dev/script/config.phpize.js",
    "/dev/script/config.w32.phpize.in",
    "/dev/script/configure.tail",
    "/dev/script/confutils.js",
    "/dev/script/Makefile.phpize",
    "/dev/script/phpize.js",
    "/dev/build/default.manifest",
    "/dev/build/template.rc",
    "/dev/deps/bin",
    "/dev/deps/openssl.cnf",
    "/dev/deps/lib/cmake",
    "/dev/deps/lib/pkgconfig",
    "/dev/deps/lib/ossl-modules",
    "/dev/deps/lib/libxml2.lib",
    "/dev/deps/lib/libxml2_a.lib",
    "/dev/deps/lib/libxml2_a_dll.lib",
    "/dev/deps/lib/zlib_a.lib",
    "/dev/deps/lib/libiconv.lib",
    "/dev/deps/lib/libiconv_a.lib",
    "/dev/deps/lib/libpq_a.lib",
    "/dev/deps/lib/libsodium_a.lib",
    "/dev/deps/lib/libsqlite3_a.lib",
    "/dev/deps/lib/brotlienc.lib",
    "/dev/deps/lib/gio-2.0.lib",
    "/dev/deps/lib/girepository-2.0.lib",
    "/dev/deps/lib/gthread-2.0.lib",
    "/dev/deps/lib/icutu.lib",
    "/dev/deps/lib/libenchant2_hunspell.lib",
    "*.exp",
    "*.pdb"
  ],
