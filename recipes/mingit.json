{
  "id": "org.git_scm.MinGit",
  "version": "2.56.0.windows.4",
  "name": "Git (MinGit)",
  "summary": "Git for Windows' minimal distribution, for tools and scripts that run git",
  "homepage": "https://gitforwindows.org/",
  "license": "GPL-2.0-only",
  "command": "cmd/git.exe",
  "path": ["cmd"],
  "layer": "estargz",
  "env": { "GIT_DISCOVERY_ACROSS_FILESYSTEM": "1" },
  "permissions": { "network": true, "filesystem": ["cwd"] },
  "modules": [
    {
      "name": "mingit",
      "sources": [
        {
          "url": "https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.4/MinGit-2.56.0.4-64-bit.zip",
          "sha256": "e3bf78351fe777fba47ddee5950082f8a98bb0f02604fdc7ba3ee2cb68ffa877"
        }
      ]
    },
    {
      "name": "config",
      "sources": [{ "path": "mingit/gitconfig", "dest": "etc/gitconfig" }]
    }
  ]
}
