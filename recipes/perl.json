  "cleanup": ["/c", "/data", "/win32", "/perl/site", "/perl/html", "/perl/man", "*.pod", "/portableshell.bat", "/relocation.pl.bat", "/update_env.pl.bat", "/README.txt", "/DISTRIBUTIONS.txt"],
  "modules": [
    {
