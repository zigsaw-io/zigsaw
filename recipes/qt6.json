{
  "id": "io.qt.Qt6",
  "version": "6.12.0",
  "name": "Qt",
  "summary": "Qt 6 (Core, Gui, Widgets, Network, Svg, Sql, image formats, translations, QML, Qt Quick) for apps built with Qt's SDK, with Designer, Linguist and qml",
  "homepage": "https://www.qt.io/",
  "license": "LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only",
  "layer": "estargz",
  "prefetch": [
    "bin/designer.exe",
    "bin/Qt6PrintSupport.dll",
    "bin/Qt6Network.dll",
    "bin/Qt6Xml.dll",
    "bin/Qt6Designer.dll",
    "bin/Qt6DesignerComponents.dll",
    "bin/Qt6Widgets.dll",
    "bin/Qt6Gui.dll",
    "bin/Qt6Core.dll",
    "bin/Qt6OpenGLWidgets.dll",
    "bin/Qt6OpenGL.dll",
    "bin/qt.conf",
    "plugins/platforms/qdirect2d.dll",
    "plugins/platforms/qminimal.dll",
    "plugins/platforms/qoffscreen.dll",
    "plugins/platforms/qwindows.dll",
    "plugins/styles/qmodernwindowsstyle.dll",
    "translations/designer_en.qm",
    "translations/qtbase_en.qm",
    "plugins/designer/qquickwidget.dll",
    "bin/Qt6QuickWidgets.dll",
    "bin/Qt6Quick.dll",
    "bin/Qt6Qml.dll",
    "bin/Qt6QmlMeta.dll",
    "bin/Qt6QmlModels.dll",
    "bin/Qt6QmlWorkerScript.dll",
    "plugins/iconengines/qsvgicon.dll",
    "plugins/imageformats/qgif.dll",
    "plugins/imageformats/qicns.dll",
    "plugins/imageformats/qico.dll",
    "plugins/imageformats/qjpeg.dll",
    "plugins/imageformats/qsvg.dll",
    "plugins/imageformats/qtga.dll",
    "plugins/imageformats/qtiff.dll",
    "plugins/imageformats/qwbmp.dll",
    "plugins/imageformats/qwebp.dll"
  ],
  "command": "bin/designer.exe",
  "path": ["bin"],
  "permissions": { "filesystem": ["cwd", "documents"] },
  "registry": ["Software\\QtProject"],
  "exports": {
    "designer": { "command": "bin/designer.exe" },
    "linguist": { "command": "bin/linguist.exe" },
    "pixeltool": { "command": "bin/pixeltool.exe" },
    "qml": { "command": "bin/qml.exe" },
    "qtdiag": { "command": "bin/qtdiag.exe" }
  },
  "shortcuts": {
    "Qt Widgets Designer": { "command": "designer", "description": "Design Qt Widgets forms" },
    "Qt Linguist": { "command": "linguist", "description": "Translate Qt apps" }
  },
  "sdk": {
    "qtsdk": "io.qt.Qt6.Sdk:6.12.0@sha256:965dba80c2f86cd874d5603658b48ed0d0c8f01d1204aba2cb1c077fb7ba0128"
  },
  "cleanup": [
    "/include",
    "/lib",
    "/mkspecs",
    "/metatypes",
    "/modules",
    "/doc",
    "/share",
    "*.a",
    "*.bat",
    "*.py",
    "*.cmake",
    "/bin/androiddeployqt.exe",
    "/bin/androiddeployqt6.exe",
    "/bin/androidtestrunner.exe",
    "/bin/harmonydeployqt.exe",
    "/bin/harmonydeployqt6.exe",
    "/bin/harmonyostestrunner.exe",
    "/bin/cmake_automoc_parser.exe",
    "/bin/moc.exe",
    "/bin/rcc.exe",
    "/bin/uic.exe",
    "/bin/qlalr.exe",
    "/bin/qmake.exe",
    "/bin/qmake6.exe",
    "/bin/qvkgen.exe",
    "/bin/syncqt.exe",
    "/bin/tracegen.exe",
    "/bin/tracepointgen.exe",
    "/bin/lupdate.exe",
    "/bin/lrelease.exe",
    "/bin/lcheck.exe",
    "/bin/ltext2id.exe",
    "/bin/wasmdeployqt.exe",
    "/bin/wasmdeployqt6.exe",
    "/bin/lprodump.exe",
    "/bin/lrelease-pro.exe",
    "/bin/lupdate-pro.exe",
    "/bin/lconvert.exe",
    "/bin/qtplugininfo.exe",
    "/bin/windeployqt.exe",
    "/bin/windeployqt6.exe",
    "/bin/qmlaotstats.exe",
    "/bin/qmlcachegen.exe",
    "/bin/qmlcontextpropertydump.exe",
    "/bin/qmldom.exe",
    "/bin/qmleasing.exe",
    "/bin/qmlformat.exe",
    "/bin/qmlimportscanner.exe",
    "/bin/qmljsrootgen.exe",
    "/bin/qmllint.exe",
    "/bin/qmlplugindump.exe",
    "/bin/qmlpreview.exe",
    "/bin/qmlprofiler.exe",
    "/bin/qmlscene.exe",
    "/bin/qmltc.exe",
    "/bin/qmltestrunner.exe",
    "/bin/qmltime.exe",
    "/bin/qmltyperegistrar.exe",
    "/bin/qsb.exe",
    "/bin/svgtoqml.exe",
    "/bin/Qt6QmlCompiler.dll",
    "/bin/Qt6QuickTest.dll",
    "/bin/Qt6Test.dll",
    "/plugins/qmllint",
    "/qml/QmlTime",
    "/qml/QtTest",
    "/qml/Qt/test"
  ],
  "modules": [
    {
      "name": "qt",
      "sources": [{ "image": "io.qt.Qt6.Sdk:6.12.0@sha256:965dba80c2f86cd874d5603658b48ed0d0c8f01d1204aba2cb1c077fb7ba0128" }]
    },
    {
      "name": "qt-conf",
      "build": ["printf '%s\\n' '[Paths]' 'Prefix = ..' > \"$PREFIX/bin/qt.conf\""]
    }
  ]
}
