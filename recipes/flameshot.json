{
  "id": "org.flameshot.Flameshot",
  "version": "14.0.0",
  "name": "Flameshot",
  "summary": "Takes screenshots, annotates them and saves or copies them, from its tray icon or the command line",
  "homepage": "https://flameshot.org/",
  "license": "GPL-3.0-or-later",
  "command": "bin/flameshot.exe",
  "path": ["bin"],
  "permissions": { "filesystem": ["pictures"] },
  "exports": {
    "flameshot": { "command": "bin/flameshot.exe" }
  },
  "shortcuts": {
    "Flameshot": { "command": "flameshot", "description": "Take and annotate screenshots" }
  },
  "cleanup": ["/bin/flameshot-cli.exe"],
  "runtimes": {
    "qt": "io.qt.Qt6:6.12.0@sha256:c74a07f23cadd6354081fc5ea858451fb8cdafeb8e926f04b652791ef0d9b22b"
  },
  "sdk": {
    "qtsdk": "io.qt.Qt6.Sdk:6.12.0@sha256:b1c559007667e012db5978cf7dd72df2d352537b628e1b208a7556ee1b14a2d7"
  },
  "modules": [
    {
      "name": "flameshot",
      "sources": [
        {
          "url": "https://github.com/flameshot-org/flameshot/archive/refs/tags/v14.0.0.tar.gz",
          "sha256": "810c399f3b9fbfd72e24e61417ede24243925f9c0d03040a8aba0d4866676d93",
          "strip": 1
        },
        {
          "url": "https://gitlab.com/mattbas/Qt-Color-Widgets/-/archive/5d52e907e50dc88cf969b41cea44665ff6c475b1/Qt-Color-Widgets-5d52e907e50dc88cf969b41cea44665ff6c475b1.tar.gz",
          "sha256": "99edd39dca0367b1cfd388bf031c4915137580bd73f87c65f7720b8a4af14efa",
          "strip": 1,
          "dest": "external/Qt-Color-Widgets"
        },
        {
          "url": "https://github.com/KDAB/KDSingleApplication/archive/refs/tags/v1.2.1.tar.gz",
          "sha256": "e3254ce9dc5ecf6d61ef83264bc61d486a307f0e3c9ed1bb2176f068cdbcbe09",
          "strip": 1,
          "dest": "external/KDSingleApplication"
        },
        {
          "url": "https://github.com/flameshot-org/QHotkey/archive/d7063877c14d5ae2b489dc70bbe02e76a43bf38b.tar.gz",
          "sha256": "d98521898cbb19b50a7281a7443ca77f6570f7ddd993a2962cb5c6bdf08fe29c",
          "strip": 1,
          "dest": "zigsaw/qhotkey"
        }
      ],
      "build": [
        "sed -i 's|^#include <algorithm>$|&\\n#include <iterator>|' src/utils/strfparse.cpp && grep -q '^#include <iterator>$' src/utils/strfparse.cpp",
        "sed -i 's|target_link_options(flameshot-cli PRIVATE /SUBSYSTEM:CONSOLE)|target_link_options(flameshot-cli PRIVATE -municode)|' src/CMakeLists.txt",
        "grep -q 'target_link_options(flameshot-cli PRIVATE -municode)' src/CMakeLists.txt",
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" -DFETCHCONTENT_FULLY_DISCONNECTED=ON -DFETCHCONTENT_SOURCE_DIR_QHOTKEY=B:/src/flameshot/zigsaw/qhotkey -DDISABLE_UPDATE_CHECKER=ON -DENABLE_IMGUR=OFF -DWINDEPLOYQT_EXE=OFF",
        "cmake --build out",
        "cmake --install out",
        "mkdir -p \"$PREFIX/bin/translations\" && cp out/src/*.qm \"$PREFIX/bin/translations/\""
      ]
    }
  ]
}
