{
  "id": "net.php.php",
  "version": "8.5.11",
  "name": "PHP",
  "summary": "PHP 8.5 (NTS, x64), the scripting language, as php.net builds it for Windows; needs the Visual C++ Redistributable",
  "homepage": "https://www.php.net/",
  "license": "PHP-3.01",
  "command": "php.exe",
  "env": { "PHPRC": "${app}", "SSL_CERT_FILE": "${roots}" },
  "permissions": { "network": true, "filesystem": ["cwd"] },
  "extensions": {
    "net.php.php": { "version": "API20250925,NTS,VS17", "join": ["PHP_INI_SCAN_DIR"] }
  },
  "exports": {
    "php": { "command": "php.exe" },
    "php-cgi": { "command": "php-cgi.exe" },
    "phpdbg": { "command": "phpdbg.exe" }
  },
  "cleanup": ["/dev", "/php8embed.lib"],
  "modules": [
    {
      "name": "php",
      "sources": [{ "image": "net.php.php.Sdk:8.5.11@sha256:50ececfb43e2bf0133243ccca664d1b28017217ccb5cb6ad06fa28700c2b1e8b" }]
    }
  ]
}
