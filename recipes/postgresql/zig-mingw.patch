PostgreSQL's MinGW build, for zig's cc and linker (zigsaw):

- zig's linker takes neither --allow-multiple-definition nor
  --disable-auto-import. The first let our getopt replace mingw's; it now
  does without, as our getopt also keeps its own variables on Windows (mingw's
  are in the object with its getopt, and linking to them brings that in).
- zig's linker has no --export-all-symbols either, so postgres.exe takes a
  .def file of everything the backend defines, as with MSVC, written by
  src/tools/mingw_gendef.pl (which the recipe adds) from nm's output.
  Extensions link against the import library made from it.
- clang's __builtin_setjmp and __builtin_longjmp, which c.h uses for
  MinGW-64 (for GCC's sake), left a backend crashing after some errors;
  with clang it uses MinGW's setjmp and longjmp.
- windres's arguments go input first: the windres the recipe builds (GTK's
  SDK's, over zig's rc) passes them in the order it gets them.

diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -302,10 +302,6 @@ elif host_system == 'windows'
     # ldflags += '/nxcompat' # generated by msbuild, should have it for ninja?
   else
     ldflags += '-Wl,--stack,@0@'.format(cdata.get('WIN32_STACK_RLIMIT'))
-    # Need to allow multiple definitions, we e.g. want to override getopt.
-    ldflags += '-Wl,--allow-multiple-definition'
-    # Ensure we get MSVC-like linking behavior.
-    ldflags += '-Wl,--disable-auto-import'
   endif
 
   os_deps += cc.find_library('ws2_32', required: true)
@@ -2740,7 +2736,10 @@ if cc.has_type('struct option',
 endif
 
 
-foreach c : ['opterr', 'optreset']
+# zigsaw: on Windows, our getopt's variables too. mingw's are in the object
+# that has its getopt, which ours replaces: linking to them brings that in,
+# and zig's lld has no --allow-multiple-definition to let ours win.
+foreach c : host_system == 'windows' ? [] : ['opterr', 'optreset']
   varname = 'HAVE_INT_' + c.underscorify().to_upper()
 
   if cc.links('''
diff --git a/src/backend/meson.build b/src/backend/meson.build
--- a/src/backend/meson.build
+++ b/src/backend/meson.build
@@ -91,6 +91,21 @@ if cc.get_id() == 'msvc'
   # be restricted to b_pch=true.
   backend_link_with += postgres_lib
 
+elif host_system == 'windows'
+  # zigsaw: zig's linker has no --export-all-symbols, so postgres.exe takes
+  # a .def file of what the backend defines, as with MSVC, made with nm.
+  postgres_def = custom_target('postgres.def',
+    command: [perl, files('../tools/mingw_gendef.pl'), find_program('nm'),
+              '@OUTPUT@', '@INPUT@'],
+    input: [postgres_lib, common_srv, pgport_srv],
+    output: 'postgres.def',
+    install: false,
+    build_by_default: false,
+  )
+
+  backend_link_args += postgres_def.full_path()
+  backend_link_depends += postgres_def
+
 endif
 
 backend_input = []
diff --git a/src/include/c.h b/src/include/c.h
--- a/src/include/c.h
+++ b/src/include/c.h
@@ -1345,7 +1345,14 @@ extern int	fdatasync(int fildes);
  * so on that toolchain we cheat and use gcc's builtins.
  */
 #ifdef WIN32
-#ifdef __MINGW64__
+/*
+ * zigsaw: not with clang (zig's cc). With its builtins, a backend crashed
+ * after some errors (a DO block in a language that doesn't exist), calling
+ * a bad portal's cleanup in MarkPortalFailed() once longjmp was back in
+ * PortalRun(). clang gives every function the SEH unwind data that MinGW's
+ * own longjmp needs.
+ */
+#if defined(__MINGW64__) && !defined(__clang__)
 typedef intptr_t sigjmp_buf[5];
 #define sigsetjmp(x,y) __builtin_setjmp(x)
 #define siglongjmp __builtin_longjmp
diff --git a/src/tools/rcgen b/src/tools/rcgen
--- a/src/tools/rcgen
+++ b/src/tools/rcgen
@@ -80,7 +80,7 @@ if args.windres:
         args.windres,
         '-I{0}/src/include/'.format(args.builddir),
         '-I{0}/src/include/'.format(args.srcdir),
-        '-o', args.out, '-i', args.rcout.name,
+        '-i', args.rcout.name, '-o', args.out,
     ]
 elif args.rc:
     cmd = [
