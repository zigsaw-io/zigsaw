+	for (i = 0; i < configdata_len; i++)
+	{
+		char		longpath[MAXPGPATH];
+		char	   *setting = configdata[i].setting;
+		DWORD		n;
+
+		if (setting[0] == '\0' || setting[1] != ':')
+			continue;
+		n = GetLongPathNameA(setting, longpath, sizeof(longpath));
+		if (n == 0 || n >= sizeof(longpath))
+			continue;
+		for (char *p = longpath; *p; p++)
+			if (*p == '\\')
+				*p = '/';
+		configdata[i].setting = pstrdup(longpath);
+	}
