{
  "id": "org.gnome.PyGObject",
  "version": "3.58.1",
  "name": "PyGObject",
  "summary": "Python 3.14 with PyGObject and pycairo, for Python apps on GTK's runtimes",
  "homepage": "https://pygobject.gnome.org/",
  "license": "LGPL-2.1-or-later AND PSF-2.0",
  "command": "python.exe",
  "path": ["."],
  "env": {
    "PYTHONPYCACHEPREFIX": "${data}\\cache\\pycache",
    "PYTHONNOUSERSITE": "1"
  },
  "exports": {},
  "cleanup": ["/include", "/libs", "/Lib/pkgconfig", "__pycache__"],
  "modules": [
    {
      "name": "pygobject",
      "sources": [{ "image": "org.gnome.PyGObject.Sdk:3.58.1@sha256:13dac3b2fd9c58e75a630a5a1e64d327bb26d3c214b5bc4bd74953d498b49ba8" }]
    }
  ]
}
