{
  "id": "io.github.nuttyartist.notes",
  "version": "2.3.1",
  "name": "Notes",
  "summary": "Takes notes in Markdown, in folders and with tags, and shows a note's to-do lists as a kanban board",
  "homepage": "https://www.notes-foss.com/",
  "license": "MPL-2.0",
  "command": "bin/Notes.exe",
  "path": ["bin"],
  "permissions": { "filesystem": ["documents"] },
  "exports": {
    "notes": { "command": "bin/Notes.exe" }
  },
  "shortcuts": {
    "Notes": { "command": "notes", "description": "Take notes" }
  },
  "runtimes": {
    "qt": "io.qt.Qt6:6.12.0@sha256:5b3217abb8c7486dfbc80e8204cd1796f725e227a1f1997bf4f9b6f83120d200"
  },
  "sdk": {
    "qtsdk": "io.qt.Qt6.Sdk:6.12.0@sha256:25ddeefda7090fe3a87a9822dd8a871d65ba0856b79f14580659980f865b4b80"
  },
  "modules": [
    {
      "name": "notes",
      "sources": [
        {
          "url": "https://github.com/nuttyartist/notes/archive/refs/tags/v2.3.1.tar.gz",
          "sha256": "de1dc90cc1b8af665a5f0aac3f2bcbf36620607b6a28d9be889fb3045f5518bd",
          "strip": 1
        },
        {
          "url": "https://github.com/b00f/qautostart/archive/efdb2e5a25e5646390f8658e3321f6e9a4c3561a.tar.gz",
          "sha256": "5eb501b31916fdb516979c6a19dc17a64711186090a29f92be4a6f0704e819cd",
          "strip": 1,
          "dest": "3rdParty/qautostart"
        },
        {
          "url": "https://github.com/pbek/qmarkdowntextedit/archive/c6420c537e219a7b7685f2bbe5e0862af631d91c.tar.gz",
          "sha256": "7c8b1e752c793fed257334352ca6967f17258df744e7ef61b094e2261a5d12f1",
          "strip": 1,
          "dest": "3rdParty/qmarkdowntextedit"
        }
      ],
      "build": [
        "sed -i 's/^    Quick)$/    Quick CorePrivate GuiPrivate WidgetsPrivate)/' CMakeLists.txt",
        "grep -q '^    Quick CorePrivate GuiPrivate WidgetsPrivate)$' CMakeLists.txt",
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" -DUPDATE_CHECKER=OFF -DGIT_REVISION=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    }
  ]
}
