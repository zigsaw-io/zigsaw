{
  "id": "org.gtk.Gtk3",
  "version": "3.24.52",
  "name": "GTK 3",
  "summary": "GTK 3 and ATK, with their typelibs, for GTK 3 apps, which have GTK 4's runtime too for GLib, Pango, cairo and the rest",
  "homepage": "https://www.gtk.org/",
  "license": "LGPL-2.1-or-later",
  "command": "about.bat",
  "path": ["bin"],
  "env": {
    "GSETTINGS_SCHEMA_DIR": "${app}\\share\\glib-2.0\\schemas"
  },
  "exports": {},
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/gir-1.0",
    "/share/aclocal",
    "/share/applications",
    "/share/gettext",
    "/share/gtk-3.0/valgrind",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.a",
    "*.lib"
  ],
  "modules": [
    {
      "name": "gtk",
      "sources": [{ "image": "org.gtk.Gtk3.Sdk:3.24.52@sha256:923dc6920094e71840379925793984d56a55d4289eddc3a49703d24e784c17a2" }]
    }
  ]
}
