{
  "id": "org.gtk.Gtk3",
  "version": "3.24.52",
  "name": "GTK 3",
  "summary": "GTK 3 and ATK, for GTK 3 apps, which have GTK 4's runtime too for GLib, Pango, cairo and the rest",
  "homepage": "https://www.gtk.org/",
  "license": "LGPL-2.1-or-later",
  "command": "about.bat",
  "path": ["bin"],
  "env": {
    "GSETTINGS_SCHEMA_DIR": "${app}\\share\\glib-2.0\\schemas"
  },
  "exports": {},
  "cleanup": [
    "/include",
    "/lib",
    "/share/aclocal",
    "/share/applications",
    "/share/gettext",
    "/share/gtk-3.0/valgrind",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.a",
    "*.lib"
  ],
  "modules": [
    {
      "name": "gtk",
      "sources": [{ "image": "org.gtk.Gtk3.Sdk:3.24.52@sha256:20a0c1d9d8a159df7e91eab846aa3dc3fbd3fad0f9450ca67b29fdc198181152" }]
    }
  ]
}
