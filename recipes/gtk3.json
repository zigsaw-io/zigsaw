{
  "id": "org.gtk.Gtk3",
  "version": "3.24.52",
  "name": "GTK 3",
  "summary": "GTK 3 and ATK, with their typelibs, for GTK 3 apps, which have GTK 4's runtime too for GLib, Pango, cairo and the rest",
  "homepage": "https://www.gtk.org/",
  "license": "LGPL-2.1-or-later",
  "command": "about.bat",
  "path": ["bin"],
  "env": {
    "GSETTINGS_SCHEMA_DIR": "${app}\\share\\glib-2.0\\schemas",
    "XDG_DATA_DIRS": "${app}\\share"
  },
  "exports": {},
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/gir-1.0",
    "/share/aclocal",
    "/share/applications",
    "/share/gettext",
    "/share/gtk-3.0/valgrind",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.a",
    "*.lib"
  ],
  "modules": [
    {
      "name": "gtk",
      "sources": [{ "image": "org.gtk.Gtk3.Sdk:3.24.52@sha256:6b4223ff1344a73717ab21107caa346cfeb3af2aa72962f22ec8990972a7c37f" }]
    }
  ]
}
