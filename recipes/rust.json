{
  "id": "org.rust-lang.rust",
  "version": "1.99.1",
  "command": "bin/cargo.exe",
  "path": ["bin", "${data}\\cargo\\bin"],
  "env": { "CARGO_HOME": "${data}\\cargo", "CARGO_PROFILE_RELEASE_STRIP": "symbols" },
  "permissions": { "sandbox": "soft", "network": true, "filesystem": ["cwd"] },
  "exports": {
    "cargo": { "command": "bin/cargo.exe" },
    "rustc": { "command": "bin/rustc.exe" }
  },
  "aliases": {
    "dlltool": { "command": "lib/rustlib/x86_64-pc-windows-gnu/bin/self-contained/dlltool.exe", "args": ["--as", "as"] }
  },
  "cleanup": [
    "/manifest.in",
    "/lib/rustlib/x86_64-pc-windows-gnu/bin/rust-lld.exe",
    "/lib/rustlib/x86_64-pc-windows-gnu/bin/gcc-ld",
    "/lib/rustlib/x86_64-pc-windows-gnu/bin/wasm-component-ld.exe"
  ],
  "modules": [
    {
      "name": "rust",
      "sources": [
        {
          "url": "https://static.rust-lang.org/dist/rustc-1.99.1-x86_64-pc-windows-gnu.tar.xz",
          "sha256": "a48f186defb3d57538b34e14a24a94f6e29906f191630b627dcb091198bae438",
          "strip": 2
        },
        {
          "url": "https://static.rust-lang.org/dist/cargo-1.99.1-x86_64-pc-windows-gnu.tar.xz",
          "sha256": "e4b9107e9f655d37200c884294e74930829f236a3e81982fc678e9fc56ae9a6b",
          "strip": 2
        },
        {
          "url": "https://static.rust-lang.org/dist/rust-std-1.99.1-x86_64-pc-windows-gnu.tar.xz",
          "sha256": "b17e3bc962ff24b3bc47a750d838defed85b280746250e3a3ad029e6c1a29dd7",
          "strip": 2
        },
        {
          "url": "https://static.rust-lang.org/dist/rust-mingw-1.99.1-x86_64-pc-windows-gnu.tar.xz",
          "sha256": "1dca8e0d253565dbf21296eabc3e8d6e06e607e92c59dc00e3ecff902fe3d5ae",
          "strip": 2
        }
      ]
    }
  ]
}
