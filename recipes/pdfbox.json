{
  "id": "org.apache.pdfbox",
  "version": "3.0.8",
  "name": "Apache PDFBox",
  "summary": "Work with PDF documents from the command line (extract text and images, merge, split, render) and look inside them with its debugger",
  "homepage": "https://pdfbox.apache.org/",
  "license": "Apache-2.0 AND MIT",
  "command": "${java}\\bin\\java.exe",
  "args": ["-jar", "${app}\\pdfbox-app.jar"],
  "permissions": { "filesystem": ["cwd", "desktop", "documents", "downloads"] },
  "registry": ["Software\\JavaSoft\\Prefs\\org\\apache\\pdfbox"],
  "runtimes": { "java": "org.openjdk.java:25.0.5_7-ea@sha256:4d05838bfe75a80fc0140a081fadf508a41504aa7dde26a9324b138f51217958" },
  "exports": {
    "pdfbox": { "command": "${java}\\bin\\java.exe", "args": ["-jar", "${app}\\pdfbox-app.jar"] },
    "pdfbox-debugger": { "command": "${java}\\bin\\javaw.exe", "args": ["-jar", "${app}\\pdfbox-app.jar", "debug"] }
  },
  "shortcuts": {
    "PDFBox Debugger": { "command": "pdfbox-debugger", "description": "Look inside PDF documents" }
  },
  "associations": {
    ".pdf": { "command": "pdfbox-debugger", "description": "PDF document" }
  },
  "sdk": {
    "maven": "org.apache.maven:3.10.0@sha256:c5d44d3870fc590a71631ec41c31c00f8cc97f39e8ce2a44808bd1fb49ef159c",
    "busybox": "net.frippery.busybox:FRP-6075-g169694ebd@sha256:db9d39727bfdd4d176b5878c0a125daa8a2396ea21e0f01a6a372f53d9d97e5d"
  },
  "modules": [
    {
      "name": "pdfbox",
      "sources": [
        {
          "url": "https://repo.maven.apache.org/maven2/org/apache/pdfbox/pdfbox-reactor/3.0.8/pdfbox-reactor-3.0.8-source-release.zip",
          "sha256": "0319436e3c5238f363b873973fe03d4a5af1c985e1e2ff0ae20e2a56f180cca7",
          "strip": 1
        }
      ],
      "vendor": {
        "commands": [
          "mvn -B -ntp -Dmaven.repo.local=vendor -pl :pdfbox-app -am package -DskipTests",
          "find vendor \\( -name _remote.repositories -o -name '*.lastUpdated' -o -name resolver-status.properties -o -name 'maven-metadata-*.xml' \\) -delete",
          "rm -rf vendor/.meta"
        ],
        "dir": "vendor",
        "sha256": "c542ae044edaa623249e1daff91f6da76c57777564d9e0819670cd1d7a34d5e1"
      },
      "build": [
        "mvn -B -ntp -o -Dmaven.repo.local=\"$PWD/vendor\" -pl :pdfbox-app -am package -DskipTests",
        "cp app/target/pdfbox-app-3.0.8.jar \"$PREFIX/pdfbox-app.jar\"",
        "cp LICENSE.txt NOTICE.txt \"$PREFIX/\""
      ]
    }
  ]
}
