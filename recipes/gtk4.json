{
  "id": "org.gtk.Gtk4",
  "version": "4.24.1",
  "command": "bin/gtk4-demo.exe",
  "path": ["bin"],
  "env": {
    "XDG_CONFIG_HOME": "${data}\\config",
    "XDG_DATA_HOME": "${data}\\share",
    "XDG_STATE_HOME": "${data}\\state",
    "XDG_CACHE_HOME": "${data}\\cache",
    "GSETTINGS_BACKEND": "keyfile"
  },
  "permissions": { "filesystem": ["cwd"] },
  "exports": {
    "gtk4-demo": { "command": "bin/gtk4-demo.exe" },
    "gtk4-widget-factory": { "command": "bin/gtk4-widget-factory.exe" },
    "gtk4-node-editor": { "command": "bin/gtk4-node-editor.exe" },
    "gtk4-print-editor": { "command": "bin/gtk4-print-editor.exe" },
    "gtk4-query-settings": { "command": "bin/gtk4-query-settings.exe" },
    "adwaita-1-demo": { "command": "bin/adwaita-1-demo.exe" }
  },
  "shortcuts": {
    "GTK Demo": { "command": "gtk4-demo", "description": "GTK's widgets and APIs at work" },
    "GTK Widget Factory": { "command": "gtk4-widget-factory", "description": "GTK's widgets in every state" },
    "Adwaita Demo": { "command": "adwaita-1-demo", "description": "libadwaita's widgets at work" }
  },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/glib-2.0",
    "/lib/graphene-1.0",
    "/lib/libpng",
    "/lib/libpng.dll",
    "/lib/pkgconfig",
    "*.a",
    "/share/thumbnailers",
    "/bin/psl-make-dafsa",
    "xmlcatalog.exe",
    "xmllint.exe",
    "rsvg-convert.exe",
    "/share/applications",
    "/share/metainfo",
    "/share/pkgconfig",
    "/share/aclocal",
    "/share/bash-completion",
    "/share/gettext",
    "/share/man",
    "/share/doc/libjpeg-turbo/example.c",
    "/share/doc/libjpeg-turbo/tjcomp.c",
    "/share/doc/libjpeg-turbo/tjdecomp.c",
    "/share/glib-2.0/codegen",
    "/share/glib-2.0/gdb",
    "/share/gtk-4.0/gtk4builder.rng",
    "/bin/gdbus-codegen",
    "/bin/glib-genmarshal",
    "/bin/glib-mkenums",
    "/bin/gtester-report",
    "*-config",
    "cjpeg.exe",
    "djpeg.exe",
    "jpegtran.exe",
    "rdjpgcom.exe",
    "wrjpgcom.exe",
    "gi-*.exe",
    "libgirepository-*"
  ],
  "modules": [
    {
      "name": "gtk",
      "sources": [{ "image": "org.gtk.Gtk4.Sdk:4.24.1@sha256:c5756c4806e9718c173a3478bfbd9a60ff0fa3d5da5c7aa847d0d6faabc41cb7" }]
    }
  ]
}
