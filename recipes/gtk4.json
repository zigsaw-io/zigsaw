{
  "id": "org.gtk.Gtk4",
  "version": "4.24.1",
  "name": "GTK",
  "summary": "GTK 4, libadwaita and the stack below them, with their typelibs, for apps built with GTK's SDK",
  "homepage": "https://www.gtk.org/",
  "license": "LGPL-2.1-or-later",
  "command": "bin/gtk4-demo.exe",
  "path": ["bin"],
  "env": {
    "XDG_CONFIG_HOME": "${data}\\config",
    "XDG_DATA_HOME": "${data}\\share",
    "XDG_STATE_HOME": "${data}\\state",
    "XDG_CACHE_HOME": "${data}\\cache",
    "XDG_DATA_DIRS": "${app}\\share",
    "GSETTINGS_BACKEND": "keyfile"
  },
  "extensions": {
    "org.gtk.Gtk4": { "version": "1", "join": ["XDG_DATA_DIRS"] }
  },
  "permissions": { "filesystem": ["cwd"] },
  "exports": {
    "gtk4-demo": { "command": "bin/gtk4-demo.exe" },
    "gtk4-widget-factory": { "command": "bin/gtk4-widget-factory.exe" },
    "gtk4-node-editor": { "command": "bin/gtk4-node-editor.exe" },
    "gtk4-print-editor": { "command": "bin/gtk4-print-editor.exe" },
    "gtk4-query-settings": { "command": "bin/gtk4-query-settings.exe" },
    "adwaita-1-demo": { "command": "bin/adwaita-1-demo.exe" },
    "gio": { "command": "bin/gio.exe" },
    "pango-view": { "command": "bin/pango-view.exe" },
    "pango-list": { "command": "bin/pango-list.exe" }
  },
  "shortcuts": {
    "GTK Demo": { "command": "gtk4-demo", "description": "GTK's widgets and APIs at work", "icon": "share/icons/org.gtk.Demo4.ico" },
    "GTK Widget Factory": { "command": "gtk4-widget-factory", "description": "GTK's widgets in every state", "icon": "share/icons/org.gtk.WidgetFactory4.ico" },
    "Adwaita Demo": { "command": "adwaita-1-demo", "description": "libadwaita's widgets at work", "icon": "share/icons/org.gnome.Adwaita1.Demo.ico" }
  },
  "sdk": {
    "gtksdk": "org.gtk.Gtk4.Sdk:4.24.1@sha256:cb3f94b1fc33196011390d2da72459cd7d7e3004e82de96e2943e9cb65e7f369"
  },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/glib-2.0",
    "/lib/graphene-1.0",
    "/lib/libpng",
    "/lib/libpng.dll",
    "/lib/pkgconfig",
    "*.a",
    "*.la",
    "*.lib",
    "/share/thumbnailers",
    "/bin/psl-make-dafsa",
    "xmlcatalog.exe",
    "xmllint.exe",
    "rsvg-convert.exe",
    "/share/applications",
    "/share/metainfo",
    "/share/pkgconfig",
    "/share/aclocal",
    "/share/bash-completion",
    "/share/gettext",
    "/share/man",
    "/share/doc/libjpeg-turbo/example.c",
    "/share/doc/libjpeg-turbo/tjcomp.c",
    "/share/doc/libjpeg-turbo/tjdecomp.c",
    "/share/glib-2.0/codegen",
    "/share/glib-2.0/gdb",
    "/share/gtk-4.0/gtk4builder.rng",
    "/bin/gdbus-codegen",
    "/bin/glib-genmarshal",
    "/bin/glib-mkenums",
    "/bin/gtester-report",
    "*-config",
    "cjpeg.exe",
    "djpeg.exe",
    "jpegtran.exe",
    "rdjpgcom.exe",
    "wrjpgcom.exe",
    "gi-*.exe",
    "libgirepository-1.0-*",
    "/python",
    "/lib/gobject-introspection",
    "/share/gir-1.0",
    "/share/gobject-introspection-1.0",
    "/bin/g-ir-*",
    "msg*.exe",
    "xgettext.exe",
    "envsubst.exe",
    "gettext.exe",
    "ngettext.exe",
    "printf_gettext.exe",
    "printf_ngettext.exe",
    "recode-sr-latin.exe",
    "iconv.exe",
    "/bin/autopoint",
    "/bin/gettextize",
    "/bin/gettext.sh",
    "/bin/po-fetch",
    "/bin/spit",
    "libgettextlib-*",
    "libgettextsrc-*",
    "libgettextpo-*",
    "libtextstyle-*",
    "/libexec",
    "/share/gettext-1.0",
    "/share/info",
    "/share/doc/gettext",
    "/share/doc/libtextstyle",
    "/share/doc/libiconv",
    "gettext-runtime.mo",
    "gettext-tools.mo"
  ],
  "modules": [
    {
      "name": "gtk",
      "sources": [{ "image": "org.gtk.Gtk4.Sdk:4.24.1@sha256:cb3f94b1fc33196011390d2da72459cd7d7e3004e82de96e2943e9cb65e7f369" }]
    },
    {
      "name": "icons",
      "sources": [{ "path": "gtk4-sdk/svg2ico.sh" }],
      "build": [
        "for app in org.gtk.Demo4 org.gtk.WidgetFactory4 org.gnome.Adwaita1.Demo; do sh svg2ico.sh \"$PREFIX/share/icons/hicolor/scalable/apps/$app.svg\" \"$PREFIX/share/icons/$app.ico\" || exit 1; done"
      ]
    }
  ]
}
