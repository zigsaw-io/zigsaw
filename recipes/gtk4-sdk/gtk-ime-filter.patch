+/* Stops filtering the display's messages, if we are. The filter's data is
+ * the context, so it must not outlive it.
+ */
+static void
+gtk_im_context_ime_remove_filter (GtkIMContextIME *context_ime)
+{
+  GdkDisplay *display = context_ime->priv->filter_display;
+
+  if (display == NULL)
+    return;
+
+  context_ime->priv->filter_display = NULL;
+  gdk_win32_display_remove_filter (GDK_WIN32_DISPLAY (display),
+                                   gtk_im_context_ime_message_filter,
+                                   context_ime);
+  g_object_unref (display);
+}
