                 if mingw.startswith(('MINGW', 'CLANG', 'UCRT')) and environ.get('VCINSTALLDIR') is None:
                     compiler_name = 'mingw32'
+                elif os.path.basename(environ.get('CC', 'cl')).lower() not in ('cl', 'cl.exe', 'clang-cl', 'clang-cl.exe'):
+                    # A GCC-like compiler named by CC outside MSYS2,
+                    # such as llvm-mingw's Clang
+                    compiler_name = 'mingw32'
                 else:
                     compiler_name = distutils.ccompiler.get_default_compiler()
             if compiler_name != 'msvc' and \
@@ -422,7 +427,11 @@
             proc = subprocess.Popen([self.compiler_cmd, '-print-search-dirs'],
                                     stdout=subprocess.PIPE)
             o, e = proc.communicate()
-            libsearch = options.library_paths
+            libsearch = list(options.library_paths)
+            # Where pkg-config says the packages' libraries are, as a
+            # compiler outside MSYS2 doesn't search there by itself
+            libsearch += [flag[2:] for flag in pkgconfig.libs_only_L(options.packages)
+                          if flag.startswith('-L')]
             for line in o.decode('ascii').splitlines():
                 if line.startswith('libraries: '):
                     libsearch += line[len('libraries: '):].split(os.pathsep)
