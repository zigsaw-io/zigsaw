@@ -24,6 +24,26 @@
 
 using namespace Qt::StringLiterals;
 
+// In an AppContainer, a process may create named pipes only in its own
+// namespace, \\.\pipe\LOCAL\: elsewhere CreateNamedPipe is denied, and a
+// QLocalServer (an app's single-instance check, say) can't listen. Servers
+// and sockets in one use that namespace for names that aren't pipe paths.
+static QLatin1StringView qt_localPipePath()
+{
+    static const bool appContainer = [] {
+        HANDLE token = nullptr;
+        DWORD isAppContainer = 0, size = 0;
+        if (OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) {
+            if (!GetTokenInformation(token, TokenIsAppContainer, &isAppContainer,
+                                     sizeof(isAppContainer), &size))
+                isAppContainer = 0;
+            CloseHandle(token);
+        }
+        return isAppContainer != 0;
+    }();
+    return appContainer ? "\\\\.\\pipe\\LOCAL\\"_L1 : "\\\\.\\pipe\\"_L1;
+}
