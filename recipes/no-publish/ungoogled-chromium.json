{
  "id": "io.github.ungoogled_software.ungoogled_chromium",
  "version": "156.0.8078.73-1.1",
  "name": "ungoogled-chromium",
  "summary": "Web browser: Chromium without Google's services",
  "homepage": "https://github.com/ungoogled-software/ungoogled-chromium",
  "license": "BSD-3-Clause",
  "command": "chrome.exe",
  "permissions": {
    "sandbox": "soft",
    "network": true,
    "filesystem": ["desktop", "documents", "downloads"],
    "unsupported": {
      "low": "Windows refuses Chromium's sandbox a window station there, so it exits with code 3; --no-sandbox gets past that, and takes its sandbox from every process",
      "appcontainer": "Windows refuses Chromium's sandbox a window station there, so it exits with code 3; --no-sandbox gets past that, and takes its sandbox from every process"
    }
  },
  "registry": ["Software\\Chromium"],
  "exports": {
    "chromium": { "command": "chrome.exe" },
    "chromium-url": { "command": "chrome.exe", "args": ["--single-argument"] }
  },
  "schemes": {
    "http": { "command": "chromium-url", "description": "Web page" },
    "https": { "command": "chromium-url", "description": "Web page" }
  },
  "shortcuts": {
    "ungoogled-chromium": { "command": "chromium", "description": "Browse the web" }
  },
  "associations": {
    ".html": { "command": "chromium", "description": "Web page" },
    ".htm": { "command": "chromium", "description": "Web page" },
    ".pdf": { "command": "chromium", "description": "PDF document" },
    ".svg": { "command": "chromium", "description": "SVG image" }
  },
  "modules": [
    {
      "name": "chromium",
      "sources": [
        {
          "url": "https://github.com/ungoogled-software/ungoogled-chromium-windows/releases/download/156.0.8078.73-1.1/ungoogled-chromium_156.0.8078.73-1.1_windows_x64.zip",
          "sha256": "360406931fb55b04ac276bcf409511bd86e4e67e6950029fc45ca5ca63443090",
          "strip": 1
        }
      ]
    }
  ]
}
