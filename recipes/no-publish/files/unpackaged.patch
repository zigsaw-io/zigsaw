diff --git a/src/Files.App/Unpackaged.cs b/src/Files.App/Unpackaged.cs
new file mode 100644
index 00000000..73beec2d
--- /dev/null
+++ b/src/Files.App/Unpackaged.cs
@@ -0,0 +1,302 @@
+// Copyright (c) Files Community
+// Licensed under the MIT License.
+
+// Files without package identity (zigsaw's patch). These types take the names
+// of the WinRT APIs that need identity, Windows.ApplicationModel.Package,
+// Windows.Storage.ApplicationData and Windows.Globalization.ApplicationLanguages,
+// so that code in Files.App.* binds to them instead: a namespace's own types
+// come before the ones its using directives import.
+
+using Microsoft.Win32;
+using System.Diagnostics.CodeAnalysis;
+using System.IO;
+using System.Xml.Linq;
+using Windows.ApplicationModel;
+using Windows.Foundation;
+using Windows.Storage;
+
+namespace Files.App
+{
+	/// <summary>
+	/// The app's identity, read from the Package.appxmanifest copied next to it.
+	/// </summary>
+	internal sealed class Package
+	{
+		public static Package Current { get; } = new();
+
+		public PackageId Id { get; }
+
+		public string DisplayName { get; }
+
+		public string InstalledPath { get; }
+
+		public string EffectivePath => InstalledPath;
+
+		public InstalledFolder InstalledLocation { get; }
+
+		/// <summary>
+		/// The languages the manifest lists as resources.
+		/// </summary>
+		public IReadOnlyList<string> Languages { get; }
+
+		private Package()
+		{
+			InstalledPath = Path.TrimEndingDirectorySeparator(AppContext.BaseDirectory);
+			InstalledLocation = new(InstalledPath);
+
+			var manifest = XDocument.Load(Path.Combine(InstalledPath, "Package.appxmanifest"));
+			XNamespace ns = "http://schemas.microsoft.com/appx/manifest/foundation/windows10";
+			var root = manifest.Root!;
+			var identity = root.Element(ns + "Identity")!;
+			var name = (string)identity.Attribute("Name")!;
+			var version = Version.Parse((string)identity.Attribute("Version")!);
+
+			Id = new(name, $"{name}_unpackaged", new((ushort)version.Major, (ushort)version.Minor, (ushort)version.Build, (ushort)version.Revision));
+			DisplayName = (string?)root.Element(ns + "Properties")?.Element(ns + "DisplayName") ?? name;
+			Languages = root.Element(ns + "Resources")?.Elements(ns + "Resource")
+				.Select(r => (string?)r.Attribute("Language"))
+				.OfType<string>()
+				.ToList() ?? [];
+		}
+	}
+
+	internal sealed record PackageId(string Name, string FamilyName, PackageVersion Version);
+
+	internal sealed record InstalledFolder(string Path);
+
+	/// <summary>
+	/// The app's data: folders under %LOCALAPPDATA%\Files Community\{name},
+	/// and settings in the registry, beside the keys Files already keeps there.
+	/// </summary>
+	internal sealed class ApplicationData
+	{
+		public static ApplicationData Current { get; } = new();
+
+		private readonly string _root = Path.Combine(
+			Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+			"Files Community",
+			Package.Current.Id.Name);
+
+		private readonly Dictionary<string, AppDataFolder> _folders = [];
+
+		public AppDataFolder LocalFolder => GetFolder("LocalState");
+
+		public AppDataFolder RoamingFolder => GetFolder("RoamingState");
+
+		public AppDataFolder TemporaryFolder => GetFolder("TempState");
+
+		public AppDataFolder LocalCacheFolder => GetFolder("LocalCache");
+
+		public ApplicationDataContainer LocalSettings { get; } =
+			new(@$"Software\Files Community\{Package.Current.Id.Name}\v1\LocalSettings");
+
+		private AppDataFolder GetFolder(string name)
+		{
+			lock (_folders)
+			{
+				if (!_folders.TryGetValue(name, out var folder))
+				{
+					folder = new(Directory.CreateDirectory(Path.Combine(_root, name)).FullName);
+					_folders[name] = folder;
+				}
+
+				return folder;
+			}
+		}
+	}
+
+	/// <summary>
+	/// One of the app's data folders. Most code wants only its path; the
+	/// StorageFolder for the rest is made when first needed, as WinRT's storage
+	/// APIs refuse paths to processes that run in an AppContainer without a
+	/// package.
+	/// </summary>
+	internal sealed class AppDataFolder(string path)
+	{
+		private StorageFolder? _storageFolder;
+
+		public string Path { get; } = path;
+
+		public StorageFolder StorageFolder
+			=> _storageFolder ??= StorageFolder.GetFolderFromPathAsync(Path).AsTask().GetAwaiter().GetResult();
+
+		public IAsyncOperation<IStorageItem> TryGetItemAsync(string name) => StorageFolder.TryGetItemAsync(name);
+
+		public IAsyncOperation<StorageFolder> CreateFolderAsync(string name, CreationCollisionOption options)
+			=> StorageFolder.CreateFolderAsync(name, options);
+
+		public IAsyncOperation<StorageFile> CreateFileAsync(string name, CreationCollisionOption options)
+			=> StorageFolder.CreateFileAsync(name, options);
+	}
+
+	/// <summary>
+	/// Settings in a registry key under HKEY_CURRENT_USER; containers are its subkeys.
+	/// </summary>
+	internal sealed class ApplicationDataContainer
+	{
+		private readonly string _key;
+
+		public ApplicationDataContainer(string key)
+		{
+			_key = key;
+			Values = new RegistryValues(key);
+		}
+
+		public IDictionary<string, object> Values { get; }
+
+		public IReadOnlyDictionary<string, ApplicationDataContainer> Containers
+		{
+			get
+			{
+				using var key = Registry.CurrentUser.OpenSubKey(_key);
+				return (key?.GetSubKeyNames() ?? []).ToDictionary(n => n, n => new ApplicationDataContainer(@$"{_key}\{n}"));
+			}
+		}
+
+		public ApplicationDataContainer CreateContainer(string name, ApplicationDataCreateDisposition disposition)
+		{
+			if (disposition is ApplicationDataCreateDisposition.Always)
+				Registry.CurrentUser.CreateSubKey(@$"{_key}\{name}").Dispose();
+
+			return new(@$"{_key}\{name}");
+		}
+
+		public void DeleteContainer(string name)
+			=> Registry.CurrentUser.DeleteSubKeyTree(@$"{_key}\{name}", false);
+	}
+
+	/// <summary>
+	/// A registry key's values as a dictionary, read and written on each access,
+	/// so that the app's processes see each other's changes, as with
+	/// ApplicationData's settings. Strings, ints and longs keep their registry
+	/// types; a bool is 1 byte of binary data, a double 8.
+	/// </summary>
+	internal sealed class RegistryValues(string key) : IDictionary<string, object>
+	{
+		public object this[string name]
+		{
+			get => TryGetValue(name, out var value) ? value : throw new KeyNotFoundException(name);
+			set
+			{
+				using var k = Registry.CurrentUser.CreateSubKey(key);
+				switch (value)
+				{
+					case string s: k.SetValue(name, s, RegistryValueKind.String); break;
+					case int i: k.SetValue(name, i, RegistryValueKind.DWord); break;
+					case long l: k.SetValue(name, l, RegistryValueKind.QWord); break;
+					case bool b: k.SetValue(name, new[] { (byte)(b ? 1 : 0) }, RegistryValueKind.Binary); break;
+					case double d: k.SetValue(name, BitConverter.GetBytes(d), RegistryValueKind.Binary); break;
+					default: throw new NotSupportedException($"Can't keep a {value?.GetType().Name ?? "null"} in the settings");
+				}
+			}
+		}
+
+		public bool TryGetValue(string name, [MaybeNullWhen(false)] out object value)
+		{
+			using var k = Registry.CurrentUser.OpenSubKey(key);
+			var raw = k?.GetValue(name);
+			if (raw is null)
+			{
+				value = null;
+				return false;
+			}
+
+			value = raw switch
+			{
+				byte[] { Length: 1 } b => b[0] != 0,
+				byte[] { Length: 8 } d => BitConverter.ToDouble(d),
+				_ => raw,
+			};
+			return true;
+		}
+
+		public bool ContainsKey(string name) => TryGetValue(name, out _);
+
+		public void Add(string name, object value)
+		{
+			if (ContainsKey(name))
+				throw new ArgumentException($"{name} is already set", nameof(name));
+
+			this[name] = value;
+		}
+
+		public bool Remove(string name)
+		{
+			using var k = Registry.CurrentUser.OpenSubKey(key, writable: true);
+			if (k?.GetValue(name) is null)
+				return false;
+
+			k.DeleteValue(name);
+			return true;
+		}
+
+		public ICollection<string> Keys
+		{
+			get
+			{
+				using var k = Registry.CurrentUser.OpenSubKey(key);
+				return k?.GetValueNames() ?? [];
+			}
+		}
+
+		public ICollection<object> Values => Keys.Select(n => this[n]).ToList();
+
+		public int Count => Keys.Count;
+
+		public bool IsReadOnly => false;
+
+		public void Clear()
+		{
+			foreach (var name in Keys)
+				Remove(name);
+		}
+
+		public void Add(KeyValuePair<string, object> item) => Add(item.Key, item.Value);
+
+		public bool Contains(KeyValuePair<string, object> item)
+			=> TryGetValue(item.Key, out var value) && Equals(value, item.Value);
+
+		public bool Remove(KeyValuePair<string, object> item) => Contains(item) && Remove(item.Key);
+
+		public void CopyTo(KeyValuePair<string, object>[] array, int arrayIndex)
+		{
+			foreach (var pair in this)
+				array[arrayIndex++] = pair;
+		}
+
+		public IEnumerator<KeyValuePair<string, object>> GetEnumerator()
+			=> Keys.Select(n => new KeyValuePair<string, object>(n, this[n])).ToList().GetEnumerator();
+
+		IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
+	}
+
+	/// <summary>
+	/// The app's languages: the manifest's, and an override that the Windows
+	/// App SDK applies to resources but doesn't keep, so the settings keep it.
+	/// </summary>
+	internal static class ApplicationLanguages
+	{
+		private const string OverrideKey = "PrimaryLanguageOverride";
+
+		public static IReadOnlyList<string> ManifestLanguages => Package.Current.Languages;
+
+		public static string PrimaryLanguageOverride
+		{
+			get => Microsoft.Windows.Globalization.ApplicationLanguages.PrimaryLanguageOverride;
+			set
+			{
+				ApplicationData.Current.LocalSettings.Values[OverrideKey] = value ?? string.Empty;
+				Microsoft.Windows.Globalization.ApplicationLanguages.PrimaryLanguageOverride = value ?? string.Empty;
+			}
+		}
+
+		/// <summary>
+		/// Applies the override kept by an earlier run; called before any resources are loaded.
+		/// </summary>
+		public static void RestoreOverride()
+		{
+			if (ApplicationData.Current.LocalSettings.Values.TryGetValue(OverrideKey, out var value) && value is string { Length: > 0 } code)
+				Microsoft.Windows.Globalization.ApplicationLanguages.PrimaryLanguageOverride = code;
+		}
+	}
+}
