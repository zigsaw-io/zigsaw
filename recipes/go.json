{
  "id": "org.golang.go",
  "version": "1.27.1",
  "command": "bin/go.exe",
  "path": ["bin", "${data}\\go\\bin"],
  "env": {
    "GOPATH": "${data}\\go",
    "GOCACHE": "${cache}",
    "GOTOOLCHAIN": "local",
    "GOFLAGS": "-trimpath -modcacherw"
  },
  "permissions": { "network": true, "filesystem": ["cwd"] },
  "exports": {
    "go": { "command": "bin/go.exe" },
    "gofmt": { "command": "bin/gofmt.exe" }
  },
  "cleanup": ["/test"],
  "modules": [
    {
      "name": "go",
      "sources": [
        {
          "url": "https://go.dev/dl/go1.27.1.windows-amd64.zip",
          "sha256": "a3911b5e0e1b1053f25ed0675f4c1c6aad1e2bfcf253df2b9be4caabd2edd95d",
          "strip": 1
        }
      ]
    }
  ]
}
