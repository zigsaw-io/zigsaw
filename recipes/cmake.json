{
  "id": "org.cmake.cmake",
  "version": "4.4.4",
  "command": "bin/cmake.exe",
  "path": ["bin"],
  "env": {
    "CMAKE_GENERATOR": "Ninja"
  },
  "permissions": { "network": true, "filesystem": ["cwd"] },
  "exports": {
    "cmake": { "command": "bin/cmake.exe" },
    "ctest": { "command": "bin/ctest.exe" },
    "cpack": { "command": "bin/cpack.exe" },
    "ninja": { "command": "bin/ninja.exe" }
  },
  "cleanup": ["/bin/cmake-gui.exe", "/doc/cmake/html", "/doc/cmake/CMake.qch", "/man"],
  "modules": [
    {
      "name": "cmake",
      "sources": [
        {
          "url": "https://github.com/Kitware/CMake/releases/download/v4.4.4/cmake-4.4.4-windows-x86_64.zip",
          "sha256": "bace36e94b31c68ab6fa295f26dfa11219e0701cf7c94b0284a7d1cb13dac536",
          "strip": 1
        }
      ]
    },
    {
      "name": "ninja",
      "sources": [
        {
          "url": "https://github.com/ninja-build/ninja/releases/download/v1.13.2/ninja-win.zip",
          "sha256": "07fc8261b42b20e71d1720b39068c2e14ffcee6396b76fb7a795fb460b78dc65",
          "dest": "bin"
        }
      ]
    }
  ]
}
